+// --- WinFleet: ritaglio della regione utile -------------------------------------
+//
+// WinFleet mostra UNA finestra di Windows come finestra del Mac. Farla seguire
+// cambiando la risoluzione dello schermo virtuale costa un secondo a colpo (mode set
+// di Windows piu' ricostruzione dell encoder di Sunshine), che e' esattamente cio'
+// che rende un ridimensionamento "a scatti" invece che dal vivo.
+//
+// Con il ritaglio quel costo sparisce: lo schermo virtuale resta fisso, su Windows si
+// ridimensiona la FINESTRA dell app (immediato, un frame), e qui si disegna solo il
+// rettangolo che quella finestra occupa. Nessun riscalo, nessuna banda nera, forma
+// libera.
+//
+// Il rettangolo arriva da un file indicato in WF_CROP, riletto quando cambia:
+// "x y larghezza altezza" in pixel dello stream. Assente o non valido, si disegna
+// tutto come fa Moonlight normalmente.
+struct WfCrop {
+    int x = 0, y = 0, w = 0, h = 0;
+    bool valid() const { return w > 0 && h > 0; }
+};
+
+static WfCrop wfReadCrop()
+{
+    static const char* path = getenv("WF_CROP");
+    static WfCrop cached;
+    static struct timespec cachedStamp = {};
+
+    if (!path) return WfCrop();
+
+    struct stat st;
+    if (stat(path, &st) != 0) return cached;
+    if (st.st_mtimespec.tv_sec == cachedStamp.tv_sec &&
+        st.st_mtimespec.tv_nsec == cachedStamp.tv_nsec) {
+        return cached;   // niente di nuovo: si evita di rileggere sessanta volte al secondo
+    }
+
+    FILE* f = fopen(path, "r");
+    if (!f) return cached;
+    WfCrop c;
+    if (fscanf(f, "%d %d %d %d", &c.x, &c.y, &c.w, &c.h) == 4) {
+        cached = c;
+        cachedStamp = st.st_mtimespec;
+    }
+    fclose(f);
+    return cached;
+}
