+// --- WinFleet: ritaglio della regione utile -------------------------------------
+//
+// WinFleet mostra UNA finestra di Windows come finestra del Mac. Farla seguire
+// cambiando la risoluzione dello schermo virtuale costa circa un secondo a colpo
+// (mode set di Windows piu ricostruzione dell encoder lato host), ed e quello che
+// rende il ridimensionamento a scatti invece che dal vivo.
+//
+// Ritagliando, quel costo sparisce: lo schermo virtuale resta fisso, su Windows si
+// ridimensiona la finestra dell app (immediato) e qui si mostra solo il rettangolo
+// che quella finestra occupa. Nessun riscalo, nessuna banda nera, forma libera.
+//
+// Il rettangolo sta in un file indicato da WF_CROP, riletto solo quando cambia:
+// "x y larghezza altezza" in pixel dello stream.
+bool StreamUtils::getWinFleetCrop(SDL_Rect* crop)
+{
+    static const char* path = getenv("WF_CROP");
+    static SDL_Rect cached = {0, 0, 0, 0};
+    static struct timespec stamp = {0, 0};
+
+    if (path == nullptr) {
+        return false;
+    }
+
+    struct stat st;
+    if (stat(path, &st) == 0 &&
+        (st.st_mtimespec.tv_sec != stamp.tv_sec || st.st_mtimespec.tv_nsec != stamp.tv_nsec)) {
+        FILE* f = fopen(path, "r");
+        if (f != nullptr) {
+            SDL_Rect r;
+            if (fscanf(f, "%d %d %d %d", &r.x, &r.y, &r.w, &r.h) == 4) {
+                cached = r;
+                stamp = st.st_mtimespec;
+            }
+            fclose(f);
+        }
+    }
+
+    if (cached.w <= 0 || cached.h <= 0) {
+        return false;
+    }
+    *crop = cached;
+    return true;
+}
