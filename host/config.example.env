# Copia in ~/.config/winfleet/config.env e compila.
HOST_TS="100.x.x.x"       # indirizzo Tailscale del PC (sempre raggiungibile)
HOST_LAN="192.168.x.x"    # indirizzo LAN del PC (preferito se in rete)
FPS=60
BITRATE=40000             # Kbps — su LAN cablata puoi salire a 80000-150000
RESOLUTION=""             # vuoto = nativa; es. 2560x1440
SUN_PORT=47990
