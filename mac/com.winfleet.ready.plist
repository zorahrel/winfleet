<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.winfleet.ready</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/zorahrel/Projects/winfleet/bin/winfleet</string>
        <string>ready</string>
    </array>
    <!-- Non al login: al login il PC di la' puo' essere spento e la rete non
         ancora su, e si otterrebbe solo un errore. Si riprova invece a
         intervalli finche' non riesce, e quando una finestra calda c'e' gia' il
         comando esce subito senza fare nulla.

         Due minuti e non dieci: la finestra calda si consuma appena la si usa,
         e con dieci minuti si restava scoperti proprio dopo aver aperto
         qualcosa, cioe' quando e' piu' probabile che si apra dell'altro. Un
         controllo a vuoto costa una manciata di millisecondi. -->
    <key>StartInterval</key>
    <integer>120</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/zorahrel/.config/winfleet/ready.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/zorahrel/.config/winfleet/ready.log</string>
</dict>
</plist>
