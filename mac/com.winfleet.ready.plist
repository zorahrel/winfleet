<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.winfleet.ready</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/zorahrel/Projects/winfleet/bin/winfleet</string>
        <string>ready</string>
    </array>
    <!-- Non al login: al login il PC di la' puo' essere spento e la rete non
         ancora su, e si otterrebbe solo un errore. Si riprova invece a
         intervalli finche' non riesce, e quando una finestra calda c'e' gia' il
         comando esce subito senza fare nulla.

         Due minuti e non dieci: la finestra calda si consuma appena la si usa,
         e con dieci minuti si restava scoperti proprio dopo aver aperto
         qualcosa, cioe' quando e' piu' probabile che si apra dell'altro. Un
         controllo a vuoto costa una manciata di millisecondi. -->
    <!-- DISATTIVATO per impostazione predefinita: le finestre di scorta non
         servono piu'. Aprire un'app da zero costa due secondi (misurato), quindi
         tenerne di pronte costerebbe due slot e due stream accesi per guadagnare
         mezzo secondo - e portava con se' una fila di guasti tutti suoi.

         Il meccanismo resta intero. Per riaccenderlo:
             WF_WARM=2 nell'ambiente, e
             launchctl bootstrap gui/$UID ~/Library/LaunchAgents/com.winfleet.ready.plist

         Con WF_WARM=0 questo agente parte, vede che non c'e' niente da fare e
         esce: qualche millisecondo ogni due minuti, ma zero lavoro utile. -->
    <key>StartInterval</key>
    <integer>120</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/zorahrel/.config/winfleet/ready.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/zorahrel/.config/winfleet/ready.log</string>
</dict>
</plist>
