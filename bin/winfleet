#!/usr/bin/env bash
# Serve bash 4 o superiore. macOS ne spedisce ancora una del 2007 (3.2, ferma per
# ragioni di licenza) e "env bash" prende quella se e' prima nel PATH: il file viene
# rifiutato con "unexpected EOF" su una riga in fondo, lontanissima dal punto vero,
# e sembra un file corrotto invece che una shell vecchia. Si riparte con quella
# giusta invece di far indovinare a chi legge l'errore.
if [ -z "${BASH_VERSINFO:-}" ] || [ "${BASH_VERSINFO[0]}" -lt 4 ]; then
  for b in /opt/homebrew/bin/bash /usr/local/bin/bash; do
    [ -x "$b" ] && exec "$b" "$0" "$@"
  done
  echo "winfleet richiede bash 4+ (questa e' ${BASH_VERSION:-sconosciuta})." >&2
  echo "Installalo con:  brew install bash" >&2
  exit 1
fi
# WinFleet — finestre di Windows sul Mac, a piena GPU.
#
# Orchestra Sunshine (host, NVENC) + Moonlight (client) per aprire le app o il
# desktop del PC Windows come FINESTRE native macOS, ridimensionabili, fluide,
# riusando la sessione già attiva sul PC (nessun login RDP).
#
#   winfleet open <app>        apre l'app in una finestra sul Mac
#   winfleet search <testo>    cerca un'app installata sul PC e la apre
#   winfleet windows           quali finestre sono aperte e su cosa
#   winfleet scan              rilegge l'elenco delle app installate sul PC
#   winfleet push              carica gli script host sul PC (C:\winfleet)
#   winfleet fit               riporta le finestre a filo dei pixel che ricevono
#   winfleet stop [n]          chiude una finestra, o tutte
#   winfleet dock <app...>     crea i lanciatori .app (nome e icona dell'app)
#   winfleet panel             pannello in barra dei menu (finestre, app, strumenti)
#   winfleet dockpanel         pannello nel Dock: click sull'icona, con la ricerca
#   winfleet icons             scarica le icone di tutte le app dell'host
#   winfleet apps              lanciatori creati
#   winfleet list              app pubblicate dall'host
#   winfleet clean             toglie da Moonlight gli host che non rispondono più
#   winfleet pair              accoppia Moonlight con l'host (una tantum)
#   winfleet doctor            diagnostica
#   winfleet endpoint          mostra quale indirizzo verrebbe usato (LAN/Tailscale)
set -euo pipefail

# ---------------------------------------------------------------------------
# Config
# ---------------------------------------------------------------------------
# Dove sta il repo, seguendo i collegamenti: il comando in ~/.local/bin e' un link,
# e senza risolverlo si cercherebbero mac/ e host/ accanto al link invece che al
# sorgente. (Prima era una copia, e una copia rimasta indietro fa provare per ore una
# versione che non e' quella che stai scrivendo.)
WF_SELF="$0"
while [ -L "$WF_SELF" ]; do
  WF_LINK="$(readlink "$WF_SELF")"
  case "$WF_LINK" in
    /*) WF_SELF="$WF_LINK" ;;
    *)  WF_SELF="$(dirname "$WF_SELF")/$WF_LINK" ;;
  esac
done
# Assoluto, sempre: questo percorso finisce dentro i lanciatori .app, e un "./bin/winfleet"
# li' dentro vale solo per chi si trova nella cartella del repo — cioe' per nessuno, quando
# a lanciarli e' il Dock. I bundle costruiti da una cartella diversa da quella del repo
# non aprivano niente.
case "$WF_SELF" in
  /*) ;;
  *)  WF_SELF="$(cd "$(dirname "$WF_SELF")" && pwd)/$(basename "$WF_SELF")" ;;
esac
WF_ROOT="$(cd "$(dirname "$WF_SELF")/.." && pwd)"

CONFIG_DIR="${WINFLEET_CONFIG:-$HOME/.config/winfleet}"
CONFIG="$CONFIG_DIR/config.env"
# Il Moonlight di WinFleet, se e' stato costruito (fork/build.sh): e' l'originale
# piu' il ritaglio, cioe' l'unico che sappia mostrare la sola finestra dell'app.
# Senza, si usa quello installato e si torna a far seguire la risoluzione.
WINFLEET_MOONLIGHT="$HOME/.local/share/winfleet/Moonlight.app"
if [ -z "${MOONLIGHT_APP:-}" ] && [ -d "$WINFLEET_MOONLIGHT" ]; then
  MOONLIGHT_APP="$WINFLEET_MOONLIGHT"
fi
MOONLIGHT_APP="${MOONLIGHT_APP:-/Applications/Moonlight.app}"
MOONLIGHT="${MOONLIGHT_BIN:-$MOONLIGHT_APP/Contents/MacOS/Moonlight}"

# Defaults, sovrascrivibili da config.env
HOST_TS=""          # indirizzo Tailscale (sempre raggiungibile)
HOST_LAN=""         # indirizzo LAN (preferito se risponde)
FPS=60
BITRATE=auto        # Kbps, o "auto" = scelto in base alla risoluzione
RESOLUTION=auto     # "auto" = nativa dell'host (nessun riscalo); es. 2560x1440
HOST_RES=""         # risoluzione desktop dell'host, rilevata al primo stream
HOST_NAME=""        # nome mDNS dell'host (es. WindowsAtti.local): indirizza le istanze per porta
SLOTS=0             # quante istanze WinFleet (monitor virtuali) ci sono sull'host
SLOT_BASE=48089     # porta della prima istanza; le successive +100
AGENT_PORT=48088    # agente sull'host: ridimensiona la finestra dell'app e conferma
SUN_PORT=47990
TITLEBAR=28         # altezza barra titolo macOS, esclusa dall'area video

# Solo le righe che sono davvero un'assegnazione, e con un nome che la shell accetta.
# Le versioni precedenti hanno scritto chiavi con lettere accentate (size_gestioneattività):
# sourcing fallisce su quella riga, e con set -e muore il comando prima di cominciare —
# qualunque comando, anche solo "winfleet doctor".
[ -f "$CONFIG" ] && . <(grep -E '^[A-Za-z_][A-Za-z0-9_]*=' "$CONFIG")

# Il nome di un'app diventa una chiave di configurazione e un identificativo di
# bundle: solo ASCII, o non e' ne' l'una ne' l'altro. "[:alnum:]" qui non basta,
# perche' tiene le lettere accentate.
slug(){ printf '%s' "$1" | LC_ALL=C tr -cd 'A-Za-z0-9' | LC_ALL=C tr 'A-Z' 'a-z'; }

c_grn=$'\033[32m'; c_red=$'\033[31m'; c_dim=$'\033[2m'; c_bold=$'\033[1m'; c_off=$'\033[0m'
ok(){ printf "  ${c_grn}✓${c_off} %s\n" "$1"; }
bad(){ printf "  ${c_red}✗${c_off} %s\n" "$1"; }
info(){ printf "  ${c_dim}○${c_off} %s\n" "$1"; }
die(){ printf "${c_red}%s${c_off}\n" "$1" >&2; exit 1; }

need_config(){
  [ -n "$HOST_TS$HOST_LAN" ] || die "Nessun host configurato.\nEsegui:  winfleet setup   (o modifica $CONFIG)"
}

# TCP reachability con deadline reale (macOS: connect non rispetta SO_SNDTIMEO)
reachable(){ # host port timeout
  local h="$1" p="$2" t="${3:-2}"
  nc -z -G "$t" "$h" "$p" >/dev/null 2>&1
}

# Sceglie l'endpoint: LAN se risponde sulla porta Sunshine, altrimenti Tailscale.
# La LAN nuda evita l'incapsulamento WireGuard → più banda utile per lo stream.
resolve_endpoint(){
  if [ -n "$HOST_LAN" ] && reachable "$HOST_LAN" "$SUN_PORT" 1; then
    echo "$HOST_LAN lan"
  elif [ -n "$HOST_TS" ] && reachable "$HOST_TS" "$SUN_PORT" 2; then
    echo "$HOST_TS tailscale"
  else
    # Una riga vuota, non un segnaposto: "read addr kind" salta gli spazi iniziali,
    # quindi " unreachable" finiva dentro addr e ogni controllo "[ -n "$addr" ]"
    # passava. A PC spento winfleet provava a connettersi a un host di nome
    # "unreachable" invece di dire che il PC e' spento.
    echo ""
  fi
}

# ---------------------------------------------------------------------------
# Risoluzione e finestra
# ---------------------------------------------------------------------------
# Moonlight scrive nel suo log la risoluzione del desktop remoto: è il modo
# più diretto di conoscerla, senza chiedere nulla all'host.
detect_host_res(){
  local l; l=$(ls -t /tmp/Moonlight-*.log 2>/dev/null | head -1)
  [ -n "$l" ] || return 1
  grep -oE "desktop resolution: [0-9]+x[0-9]+" "$l" | tail -1 | awk '{print $3}'
}

save_cfg(){ # chiave valore
  local k="$1" v="$2"
  mkdir -p "$CONFIG_DIR"; touch "$CONFIG"
  if grep -q "^$k=" "$CONFIG"; then
    sed -i '' "s|^$k=.*|$k=\"$v\"|" "$CONFIG"
  else
    printf '%s="%s"\n' "$k" "$v" >>"$CONFIG"
  fi
}

# Senza --resolution Moonlight chiede 1280x720 e l'host riscala: immagine molle
# e banda sprecata. Nativa = nessun riscalo.
stream_res(){
  case "$RESOLUTION" in
    auto|"") [ -n "$HOST_RES" ] && echo "$HOST_RES" ;;
    *)       echo "$RESOLUTION" ;;
  esac
}

# Bitrate proporzionato ai pixel: 40 Mbps su un ultrawide è poco, su 720p è spreco.
stream_bitrate(){ # risoluzione
  [ "$BITRATE" = auto ] || { echo "$BITRATE"; return; }
  local res="$1" px
  [ -n "$res" ] || { echo 20000; return; }
  px=$(( ${res%x*} * ${res#*x} ))
  if   [ "$px" -le 1000000 ]; then echo 20000
  elif [ "$px" -le 2100000 ]; then echo 30000
  elif [ "$px" -le 3700000 ]; then echo 50000
  else                             echo 80000
  fi
}

# Moonlight apre due processi (la finestra elenco e quella dello stream) e in
# windowed mode dimensiona la finestra come la risoluzione remota: con un host
# ultrawide finisce fuori dallo schermo del Mac. Questo demone la tiene dentro
# lo schermo e agganciata alle proporzioni dello stream, così si ridimensiona e
# si sposta liberamente ma l'immagine riempie sempre la finestra, senza bande.
stream_pid(){ pgrep -f "Moonlight.*stream" | tail -1; }

win_fix(){ # pid larghezza altezza
  # Il processo va indirizzato con "tell (first process whose unix id is N)":
  # assegnarlo a una variabile e usare "windows of p" fa risolvere il filtro per
  # indice, e con due processi Moonlight si finisce sulla finestra sbagliata.
  local cap; cap="$(usable_screen)"
  osascript >/dev/null 2>&1 <<EOF
set tb to $TITLEBAR
set ar to ($2 / $3)
set scrW to ${cap%x*}
set scrH to $(( ${cap#*x} + TITLEBAR ))
try
  tell application "System Events" to tell (first process whose unix id is $1)
    if (count of windows) is 0 then return
    set sz to size of item 1 of windows
    set pos to position of item 1 of windows
    set ww to item 1 of sz
    if ww > scrW then set ww to scrW
    set hh to round (ww / ar) rounding as taught in school
    if hh > (scrH - tb) then
      set hh to scrH - tb
      set ww to round (hh * ar) rounding as taught in school
    end if
    if (item 1 of sz) is not ww or (item 2 of sz) is not (hh + tb) then
      set size of item 1 of windows to {ww, hh + tb}
    end if
    set px to item 1 of pos
    set py to item 2 of pos
    if px < 0 then set px to 0
    if py < 0 then set py to 0
    if (px + ww) > scrW then set px to (scrW - ww)
    if (py + hh + tb) > scrH then set py to (scrH - hh - tb)
    if px is not (item 1 of pos) or py is not (item 2 of pos) then
      set position of item 1 of windows to {px, py}
    end if
  end tell
on error
  return
end try
EOF
}

# L'istanza GUI di Moonlight (l'elenco "Computers") resta aperta dietro allo
# stream: nasconderla lascia sullo schermo solo la finestra dell'app.
# Si nascondono solo i Moonlight che NON stanno trasmettendo: l'eseguibile dentro
# ogni bundle per app si chiama Moonlight come l'originale, quindi cercare per nome
# farebbe sparire le finestre delle altre app.
hide_gui(){ # pid dello stream da lasciare visibile
  local g
  for g in $(pgrep -x Moonlight 2>/dev/null); do
    [ "$g" = "$1" ] && continue
    ps -p "$g" -o args= 2>/dev/null | grep -q " stream " && continue
    osascript -e "tell application \"System Events\" to set visible of (first process whose unix id is $g) to false" >/dev/null 2>&1 || true
  done
}

aspect_keeper(){ # pid larghezza altezza
  local pid="$1" rw="$2" rh="$3"
  ( while kill -0 "$pid" 2>/dev/null; do win_fix "$pid" "$rw" "$rh"; sleep 0.5; done ) >/dev/null 2>&1 &
  disown 2>/dev/null || true
}

# Dimensione della finestra dello stream, in punti. Quando c'e' la libreria dentro
# il processo la misura la scrive lei in un file a ogni cambiamento: leggerla costa
# nulla, mentre chiederla ad AppleScript costa decine di millisecondi — troppo per
# guardarla dieci volte al secondo mentre si trascina.
win_size(){ # pid
  if [ -n "${WF_SIZE_FILE:-}" ] && [ -s "$WF_SIZE_FILE" ]; then
    cat "$WF_SIZE_FILE"; return
  fi
  win_size_ax "$1"
}

win_size_ax(){ # pid
  osascript 2>/dev/null <<EOF
try
  tell application "System Events" to tell (first process whose unix id is $1)
    if (count of windows) is 0 then return ""
    set sz to size of item 1 of windows
    return (((item 1 of sz) as integer) as text) & "x" & ((((item 2 of sz) - $TITLEBAR) as integer) as text)
  end tell
on error
  return ""
end try
EOF
}

# macOS non lascia crescere una finestra oltre il bordo dello schermo e la tronca in
# silenzio, quindi prima si sposta e poi si dimensiona. Il metro e' la misura vera
# presa con una finestra in mano: il rettangolo del desktop di Finder e' l'unione di
# tutti gli schermi, e con due monitor promette spazio che una finestra non ha.
win_set(){ # pid larghezza altezza
  local cap scrW scrH
  cap="$(usable_screen)"
  scrW="${cap%x*}"; scrH=$(( ${cap#*x} + TITLEBAR ))
  osascript >/dev/null 2>&1 <<EOF
try
  tell application "System Events" to tell (first process whose unix id is $1)
    if (count of windows) is 0 then return
    set pos to position of item 1 of windows
    set px to item 1 of pos
    set py to item 2 of pos
    if px < 0 or (px + $2) > $scrW then set px to 0
    if py < 0 or (py + $3 + $TITLEBAR) > $scrH then set py to 0
    set position of item 1 of windows to {px, py}
    set size of item 1 of windows to {$2, $3 + $TITLEBAR}
    -- Se e' stata troncata lo stesso, si riprova dall'angolo: la misura di
    -- riferimento e' stata presa li', quindi li' lo spazio c'e' di sicuro.
    set got to size of item 1 of windows
    if (item 1 of got) is not $2 or (item 2 of got) is not ($3 + $TITLEBAR) then
      set position of item 1 of windows to {0, 0}
      set size of item 1 of windows to {$2, $3 + $TITLEBAR}
    end if
  end tell
end try
EOF
}

# Quanto puo' essere grande una finestra su questo Mac, in punti: si chiede una
# finestra enorme e si guarda cosa concede macOS. Vuoto se non c'e' una finestra
# con cui misurare.
screen_measure(){ # pid di una finestra gia' aperta
  [ -n "${1:-}" ] || { echo ""; return; }
  osascript 2>/dev/null <<EOF
try
  tell application "System Events" to tell (first process whose unix id is $1)
    if (count of windows) is 0 then return ""
    set old to size of item 1 of windows
    set oldPos to position of item 1 of windows
    set position of item 1 of windows to {0, 0}
    set size of item 1 of windows to {99999, 99999}
    set big to size of item 1 of windows
    set size of item 1 of windows to old
    set position of item 1 of windows to oldPos
    return (((item 1 of big) as integer) as text) & "x" & (((item 2 of big) as integer) as text)
  end tell
on error
  return ""
end try
EOF
}

# Ripiego quando non c'e' nessuna finestra da misurare. Il rettangolo del desktop di
# Finder e' l'unione di tutti gli schermi, quindi con piu' monitor e' piu' grande di
# quanto una finestra possa diventare: va bene per partire, non per essere salvato.
screen_guess(){
  osascript -e 'tell application "Finder" to get bounds of window of desktop' 2>/dev/null |
    awk -F', *' '{printf "%dx%d", $3, $4}'
}

# Aspetta che il ridimensionamento si fermi e restituisce la modalita' da adottare;
# vuoto se lo stream e' finito. Ridimensionare la finestra sul Mac deve cambiare
# davvero la risoluzione dello schermo su Windows, non scalare l'immagine.
# WINFLEET_TRACE=1 registra cosa vede il sorvegliante: e' l'unico modo di capire
# perche' una finestra "si ridimensiona da sola" senza starle davanti a guardarla.
trace(){ [ -n "${WINFLEET_TRACE:-}" ] && printf '%s %s\n' "$(date +%T)" "$*" >>"$CONFIG_DIR/trace.log" || true; }

# Ridimensionare dal vivo, davvero.
#
# La strada precedente era far seguire la RISOLUZIONE dello schermo virtuale. Funziona
# ma costa circa un secondo a colpo — il mode set di Windows piu' la ricostruzione
# dell'encoder di Sunshine, che si legge nel suo log — e un secondo di attesa a ogni
# ritocco non e' un ridimensionamento, e' una serie di scatti.
#
# Adesso lo schermo virtuale non si tocca piu': resta della misura con cui e' nato, e
# a seguire la finestra del Mac e' la FINESTRA dell'app su Windows (una SetWindowPos,
# un frame). Quello che avanza dello schermo non si vede perche' il client mostra solo
# il rettangolo dell'app — e' il ritaglio, ed e' la ragione del fork in fork/.
#
# Il rettangolo lo scrive la libreria dentro il processo a ogni evento di
# ridimensionamento, quindi segue il trascinamento senza ritardo; qui si manda a
# Windows la misura nuova appena la finestra si ferma per un istante.
follow_resize(){ # pid slot misura-iniziale file-ritaglio
  local pid="$1" slot="$2" sent="$3" cropf="$4" cur cw ch got aw ah idle=0
  aw="${3%x*}"; ah="${3#*x}"
  trace "segui: slot=$slot misura iniziale=$sent"
  got="$(rect_set "$slot" "$aw" "$ah")"
  case "$got" in "ok "*) aw="$(echo "$got" | awk '{print $2}')"; ah="$(echo "$got" | awk '{print $3}')";; esac
  printf '0 0 %s %s\n' "$aw" "$ah" >"$cropf"

  while kill -0 "$pid" 2>/dev/null; do
    cur="$(win_size "$pid")"
    if [ -n "$cur" ] && [ "$cur" != "$sent" ]; then
      cw="${cur%x*}"; ch="${cur#*x}"

      # Rimpicciolire e' sempre sicuro: si mostra meno di quello che c'e' gia'. Si fa
      # subito, cosi' il ritaglio non resta indietro rispetto alla finestra.
      if [ "$cw" -le "$aw" ] && [ "$ch" -le "$ah" ]; then
        printf '0 0 %s %s\n' "$cw" "$ch" >"$cropf"
      fi

      # Allargare no: finche' la finestra su Windows non e' cresciuta davvero, dietro
      # c'e' il desktop, e allargare il ritaglio prima lo mostrerebbe. Si aspetta la
      # conferma, che dice anche quanto e' stata fatta grande per davvero — un'app con
      # una misura minima propria non arriva dove le si chiede.
      got="$(rect_set "$slot" "$cw" "$ch")"
      case "$got" in
        "ok "*)
          aw="$(echo "$got" | awk '{print $2}')"; ah="$(echo "$got" | awk '{print $3}')"
          printf '0 0 %s %s\n' "$(( cw < aw ? cw : aw ))" "$(( ch < ah ? ch : ah ))" >"$cropf"
          ;;
      esac
      sent="$cur"
      sed -i '' "s/^mode=.*/mode=$cur/" "$(slot_file "$slot")" 2>/dev/null || true
      idle=0
    else
      idle=$(( idle + 1 ))
    fi
    # Trenta letture al secondo servono solo MENTRE si trascina. Il resto del tempo
    # sono trenta processi al secondo per sentirsi rispondere che non e' cambiato
    # niente, e su una macchina che sta anche decodificando un video a 60 fps quel
    # rumore si sente sull'input. Dopo un secondo di quiete si rallenta; al primo
    # movimento si torna reattivi, quindi il trascinamento resta fluido come prima.
    if [ "$idle" -gt 30 ]; then sleep 0.25; else sleep 0.03; fi
  done
  echo ""
}

supervise_window(){ # slot app risoluzione-di-negoziazione chiave exe misura-finestra
  local slot="$1" app="$2" smode="$3" key="$4" exe="$5" wsize="$6"
  local addr pid br want i bin cropf="$CONFIG_DIR/slot$1.crop"
  # smode = risoluzione con cui si negozia la sessione, e massimo che lo schermo
  #         virtuale potra' prendere. Non cambia mai finche' la finestra vive.
  # wsize = quanto grande sta la finestra sul Mac. Puo' essere piu' piccola: lo
  #         schermo di Windows la segue a caldo, senza riaprire nulla.
  local -a pre=()
  # Il pid di QUESTA subshell, letto una volta sola qui: dentro $(...) BASHPID e'
  # della sotto-subshell che muore subito, e il numero salvato non corrisponderebbe a
  # nessun processo vivo - lo slot risulterebbe morto pur essendo occupato.
  local sup_pid="${BASHPID:-$$}"
  # Comunque finisca la funzione - chiusura normale, kill dall'esterno, terminale che
  # se ne va - lo stato dello slot va tolto e l'app su Windows chiusa. Senza, chiudere
  # la finestra dal Mac lasciava lo slot "occupato" per sempre: winfleet rispondeva
  # "tutte le finestre sono occupate" con lo schermo vuoto davanti, e l'unico rimedio
  # era cancellare i file a mano. La pulizia in fondo alla funzione non basta: ci si
  # arriva solo se il ciclo esce dalla porta principale.
  # $pid e' lo stream: va ucciso esplicitamente, perche' non muore col padre - e
  # finche' vive tiene occupata la sessione di Sunshine, quindi lo slot risulta in uso
  # anche dopo che il supervisore non c'e' piu'.
  #
  # Il "${pid:-0}" che stava qui era una bomba. La trap viene armata QUI, ma $pid
  # riceve un valore solo ~40 righe piu' sotto (pid=$!): se si esce nel mezzo -
  # l'host non risponde, lo stream non parte, arriva un TERM - l'espansione dava
  # `kill 0`, che in POSIX non vuol dire "non uccidere niente" ma "manda il segnale
  # a TUTTO il mio process group". Chiamato da dentro una sessione jcode quel gruppo
  # e' il daemon jcode: il 16/08/2026 ha ammazzato il server 15 volte, e ogni morte
  # lasciava 8 sessioni a ciclare su reconnect per 45 minuti. Riprodotto in
  # isolamento replicando questa struttura.
  # Ora: si uccide solo se c'e' davvero un pid, e mai il gruppo.
  trap 'if [ -n "${pid:-}" ] && [ "$pid" -gt 0 ] 2>/dev/null; then kill "$pid" 2>/dev/null; fi; place_stop "$slot" 2>/dev/null; slot_forget "$slot" 2>/dev/null; exit' EXIT INT TERM HUP
  addr="$(slot_addr "$slot")"
  bin="$(runner_bin "$app")"
  # Con la libreria dentro, la geometria la tiene lei: sa distinguere un
  # trascinamento dell'utente da una correzione di Moonlight, cosa che da fuori non
  # si puo' fare.
  local owned=""
  chrome_hidden "$bin" && owned=1
  # Prima dello stream, cosi' il client legge il nome nuovo al primo poll e la
  # finestra nasce gia' intitolata all'app.
  trace "avvio: slot=$slot app=$app stream=$smode finestra=$wsize bin=$bin"
  rename_instance "$slot" "$app"
  trace "rinominata"
  local first=1
  while true; do
    vdd_set "$slot" "$smode"
    trace "risoluzione chiesta"
    sleep 2
    # L'app si avvia una volta sola: al cambio di risoluzione la rimette a misura il
    # task che la tiene sul suo schermo, quindi si ritrova ridimensionata invece che
    # ripartita da capo.
    [ "$first" = 1 ] && { place_app "$slot" "$exe"; first=0; trace "app avviata"; }
    br="$(stream_bitrate "$smode")"
    if [ -n "$owned" ]; then
      WF_SIZE_FILE="$CONFIG_DIR/slot$slot.size"; rm -f "$WF_SIZE_FILE"
      # Il rettangolo da mostrare: l'app sta nell'angolo in alto a sinistra dello
      # schermo virtuale, quindi coincide con la misura della finestra. Lo scrive la
      # libreria a ogni evento di ridimensionamento, cosi' segue il trascinamento
      # senza ritardo; il Moonlight di fork/ lo rilegge quando cambia.
      cropf="$CONFIG_DIR/slot$slot.crop"
      printf '0 0 %s %s\n' "${wsize%x*}" "${wsize#*x}" >"$cropf"
      pre=( env "DYLD_INSERT_LIBRARIES=$CHROME_LIB" "WF_WIN=$wsize" \
            "WF_SIZE=$WF_SIZE_FILE" "WF_CROP=$cropf" \
            "WF_AGENT=$(agent_host):$AGENT_PORT" "WF_SLOT=$slot" )
      # Diagnostica, spenta salvo richiesta: WF_DEBUG stampa la geometria della
      # finestra vera, WF_SELFTEST prova da dentro chi si prende il click sulla
      # barra. Dall'esterno non e' verificabile senza Accessibilita'.
      [ -n "${WF_DEBUG:-}" ]    && pre+=( "WF_DEBUG=$WF_DEBUG" )
      [ -n "${WF_SELFTEST:-}" ] && pre+=( "WF_SELFTEST=$WF_SELFTEST" )
    fi
    ${pre[@]+"${pre[@]}"} "$bin" stream "$addr" Desktop --display-mode windowed \
      --fps "$FPS" --bitrate "$br" \
      --absolute-mouse --no-vsync --quit-after --resolution "$smode" \
      >"$CONFIG_DIR/stream-slot$slot.log" 2>&1 &
    pid=$!
    # Se la libreria iniettata non e' caricabile dyld ammazza il processo subito,
    # prima di eseguire una riga: meglio accorgersene e riprovare senza, con la barra
    # del titolo al suo posto, che lasciare una finestra che non si apre mai.
    if [ -n "$owned" ]; then
      sleep 2
      if ! kill -0 "$pid" 2>/dev/null; then
        trace "avvio fallito con la libreria: riprovo senza"
        owned=""; pre=(); TITLEBAR=28
        "$bin" stream "$addr" Desktop --display-mode windowed \
          --fps "$FPS" --bitrate "$br" \
          --absolute-mouse --no-vsync --quit-after --resolution "$smode" \
          >"$CONFIG_DIR/stream-slot$slot.log" 2>&1 &
        pid=$!
      fi
    fi
    slot_save "$slot" "$app" "$wsize" "$pid" "$sup_pid"
    for i in $(seq 1 60); do sleep 0.5; [ -n "$(win_size "$pid")" ] && break; done
    # Prima finestra della vita: e' l'unica occasione per sapere quanto grande la
    # puo' fare macOS davvero. Da qui in poi il dato e' in config.
    usable_screen "$pid" >/dev/null
    hide_gui "$pid"
    if [ -z "$owned" ]; then
      # Senza libreria non c'e' modo di sapere chi ha ridimensionato, quindi si tiene
      # la misura per qualche secondo: tanto basta ad annullare la correzione all'80%
      # che Moonlight fa poco dopo l'apertura.
      local now cwn
      for i in $(seq 1 20); do
        now="$(win_size "$pid")"; cwn="${now%x*}"
        if [ -n "$cwn" ] && { [ $(( cwn * 100 )) -lt $(( 95 * ${wsize%x*} )) ] || \
                              [ $(( cwn * 100 )) -gt $(( 105 * ${wsize%x*} )) ]; }; then
          win_set "$pid" "${wsize%x*}" "${wsize#*x}"
        fi
        sleep 0.5
      done
    fi
    trace "aperta: stream=$smode finestra=$(win_size "$pid") (chiesta $wsize)"

    want="$(follow_resize "$pid" "$slot" "$wsize" "$cropf")"
    # La misura si legge finche' la finestra c'e' ancora: serve a riaprirla domani
    # come l'ha lasciata l'utente.
    local seen; seen="$(win_size "$pid")"
    [ -n "$seen" ] && { wsize="$seen"; save_cfg "size_$key" "$wsize"; }
    kill "$pid" 2>/dev/null
    wait "$pid" 2>/dev/null
    # want vuoto vuol dire che nessuno ha chiesto una misura nuova: la finestra e'
    # stata chiusa, quindi si esce invece di riaprirla. E' il ramo che fa della X
    # una chiusura e non un lampeggio.
    [ -n "$want" ] || break
    smode="$want"; wsize="$want"
    refresh_vdd
  done
  place_stop "$slot"
  slot_forget "$slot"
}

# Rinegozia la sessione sulla misura esatta della finestra: mentre trascini lo
# schermo di Windows la segue a caldo, ma l'immagine resta scalata da quella
# negoziata all'apertura. Questo la rimette a filo di pixel — al prezzo di una
# riapertura di pochi secondi, che quindi decidi tu e non succede da sola.
cmd_fit(){
  local i n=0
  for i in $(seq 0 $(( ${SLOTS:-0} - 1 ))); do
    slot_live "$i" || continue
    : >"$CONFIG_DIR/slot$i.fit"
    ok "$(slot_get "$i" app): rimetto a fuoco  ${c_dim}$(slot_get "$i" mode)${c_off}"
    n=$(( n + 1 ))
  done
  [ "$n" -gt 0 ] || info "nessuna finestra aperta"
}

# ---------------------------------------------------------------------------
# Istanze e monitor virtuali (una finestra per istanza)
# ---------------------------------------------------------------------------
VDD_CACHE="$CONFIG_DIR/vdd.json"

slot_port(){ echo $(( SLOT_BASE + $1 * 100 )); }

# Moonlight cerca prima fra gli host che gia' conosce e li confronta per indirizzo
# ignorando la porta: con "192.168.1.3:48089" finirebbe sull'istanza di sistema.
# Il nome mDNS non collide con nulla, quindi indirizza l'istanza giusta.
slot_addr(){ echo "$HOST_NAME:$(slot_port "$1")"; }

slot_state(){ # slot -> SUNSHINE_SERVER_FREE | ..._BUSY | vuoto
  # Due secondi, non quattro, e --connect-timeout separato: quattro slot interrogati
  # in fila fanno l'attesa per quattro, e "winfleet windows" e' un comando a cui si
  # guarda la risposta, non uno che si lancia e si aspetta. Se un'istanza e' giu' lo
  # si scopre in due secondi invece che in sedici.
  curl -s --max-time 2 --connect-timeout 1 \
    "http://$HOST_NAME:$(slot_port "$1")/serverinfo?uniqueid=winfleet" 2>/dev/null \
    | tr '<' '\n' | awk -F'>' '/^state/{print $2}'
}

# L'host dichiara la finestra occupata solo quando lo stream e' partito, e fra
# l'apertura e quel momento passano secondi: senza la prenotazione locale due app
# aperte di fila finiscono sulla stessa finestra.
pick_slot(){
  local i
  for i in $(seq 0 $(( SLOTS - 1 ))); do
    slot_live "$i" && continue
    case "$(slot_state "$i")" in *FREE*) echo "$i"; return 0;; esac
  done
  return 1
}

refresh_vdd(){
  need_ssh
  ssh -o BatchMode=yes -o ConnectTimeout=10 "$HOST_SSH" "type C:\\winfleet\\vdd.json" 2>/dev/null \
    | tr -d '\r' >"$VDD_CACHE.tmp"
  if [ -s "$VDD_CACHE.tmp" ]; then mv "$VDD_CACHE.tmp" "$VDD_CACHE"; else rm -f "$VDD_CACHE.tmp"; fi
}

vdd_field(){ # slot campo
  [ -s "$VDD_CACHE" ] || refresh_vdd
  VDD_CACHE="$VDD_CACHE" WF_SLOT="$1" WF_FIELD="$2" python3 -c '
import json, os, sys
try:
    for m in json.load(open(os.environ["VDD_CACHE"])):
        if m["slot"] == int(os.environ["WF_SLOT"]):
            print(m[os.environ["WF_FIELD"]]); break
except Exception:
    pass
' 2>/dev/null
}

# Il monitor virtuale accetta solo un elenco fisso di modalita': si prende quella
# piu' vicina alla finestra. La piu' vicina e basta: preferire una che la CONTENGA
# aveva senso quando lo stream veniva rinegoziato ogni volta, ora significherebbe
# dare a Windows 1680x1050 per una finestra di 1449x905 — l'app si disporrebbe piu'
# larga di come la si vede, cioe' testo rimpicciolito.
#
# Il tetto non e' un lusso. macOS non lascia crescere una finestra oltre lo schermo
# e la tronca in silenzio: una modalita' piu' grande dello schermo verrebbe letta
# come "l'utente ha ridimensionato", facendo ripartire il giro all'infinito.
# Nota: il programma Python qui sotto sta dentro apici semplici, quindi NON puo'
# contenere apostrofi — nemmeno nei commenti, o la stringa della shell si chiude a
# meta' e Python riceve spezzoni. La penalita' sulla forma serve perche' la sessione
# e' negoziata a un rapporto solo: se lo schermo di Windows ne prende un altro,
# Sunshine riempie il resto di nero.
nearest_mode(){ # slot larghezza altezza [maxLarghezza maxAltezza]
  local modes; modes="$(vdd_field "$1" modes)"
  [ -n "$modes" ] || { echo ""; return; }
  WF_MODES="$modes" WF_W="$2" WF_H="$3" WF_MAXW="${4:-0}" WF_MAXH="${5:-0}" python3 -c '
import os
w, h = int(os.environ["WF_W"]), int(os.environ["WF_H"])
maxw, maxh = int(os.environ["WF_MAXW"]), int(os.environ["WF_MAXH"])
best, score = None, None
for m in os.environ["WF_MODES"].split():
    mw, mh = (int(x) for x in m.split("x"))
    s = (mw - w) ** 2 + (mh - h) ** 2
    if abs(mw * h - mh * w) * 100 > h * w:
        s += 8_000_000
    if maxw and (mw > maxw or mh > maxh):
        s += 16_000_000
    if score is None or s < score:
        best, score = m, s
print(best or "")
'
}

# Quanto puo' essere grande l'area video di una finestra su questo Mac, in punti.
# La misura vera la si puo' fare solo con una finestra in mano, quindi la prima
# volta che ce n'e' una la si registra e da li' in poi si riusa.
usable_screen(){ # [pid con cui misurare, se ancora non si sa]
  local s="${SCREEN:-}"
  # Misurare disturba la finestra (la si gonfia e la si rimette a posto), quindi
  # lo si fa una volta sola: il risultato vale per tutte le aperture successive.
  if [ -z "$s" ] && [ -n "${1:-}" ]; then
    s="$(screen_measure "$1")"
    [ -n "$s" ] && { save_cfg SCREEN "$s"; SCREEN="$s"; }
  fi
  [ -n "$s" ] || s="$(screen_guess)"
  [ -n "$s" ] || { echo ""; return; }
  echo "${s%x*}x$(( ${s#*x} - TITLEBAR ))"
}

# Sunshine non lancia l'app: per aprire una finestra nella sessione interattiva
# duplicherebbe il token della console, privilegio riservato a LocalSystem. La apre
# quindi un task nostro, e Sunshine si limita a trasmettere lo schermo.
place_app(){ # slot percorso-exe
  need_ssh
  ssh -o BatchMode=yes -o ConnectTimeout=10 "$HOST_SSH" \
    "powershell -NoProfile -Command \"schtasks /end /tn winfleet-place$1 | Out-Null; Set-Content 'C:\\winfleet\\app$1.txt' '$2'; Start-Sleep 1; schtasks /run /tn winfleet-place$1 | Out-Null\"" >/dev/null 2>&1 || true
}

place_stop(){ # slot
  [ -n "${HOST_SSH:-}" ] || return 0
  # In secondo piano e con un tetto complessivo. ConnectTimeout copre solo la
  # connessione: se il PC risponde ma PowerShell ci mette (o non torna), il comando
  # resta appeso per sempre - e questo sta dentro "winfleet stop", che deve chiudere
  # una finestra, non aspettare Windows. Chiudere lo stream sul Mac e' gia' successo;
  # fermare l'app di la' e' pulizia, e la pulizia non blocca chi l'ha chiesta.
  ( ssh -o BatchMode=yes -o ConnectTimeout=5 -o ServerAliveInterval=2 -o ServerAliveCountMax=3 "$HOST_SSH" \
    "powershell -NoProfile -Command \"schtasks /end /tn winfleet-place$1 | Out-Null; if (Test-Path 'C:\\winfleet\\pid$1.txt') { Stop-Process -Id ([int](Get-Content 'C:\\winfleet\\pid$1.txt').Trim()) -Force -EA SilentlyContinue }\"" >/dev/null 2>&1 || true ) &
  disown 2>/dev/null || true
}

app_exe(){ # nome app -> percorso sull'host
  [ -s "$HOST_APPS" ] || return 1
  awk -F'\t' -v n="$1" 'tolower($1)==tolower(n){print $2; exit}' "$HOST_APPS"
}

# Un canale aperto una volta e tenuto lì: mentre trascini le richieste sono tante e
# ravvicinate, e far nascere un processo ssh per ognuna costava piu' della richiesta
# stessa. Qui si scrive una riga su una pipe e la legge un PowerShell gia' in ascolto
# dall'altra parte.
# Quanto grande sta la finestra dell'app su Windows. E' una SetWindowPos: un frame,
# non il secondo che costa cambiare risoluzione allo schermo.
#
# Su macOS Moonlight intitola la finestra col nome dell'host, e basta quello
# (session.cpp). Il nome lo rilegge dal serverinfo a ogni poll, quindi chiamare
# l'istanza come l'app fa comparire "Telegram" sulla barra del titolo invece del
# nome di un'istanza di streaming.
rename_instance(){ # slot nome
  need_ssh
  local b64; b64="$(printf '%s' "$2" | base64 | tr -d '\n')"
  # Mai fatale: se il nome non cambia la finestra si chiamera' come l'istanza invece
  # che come l'app — brutto, non bloccante. Con set -e un ssh non-zero ucciderebbe il
  # sorvegliante in silenzio, e la finestra non si aprirebbe piu'.
  ssh "${SSH_OPTS[@]}" -o ConnectTimeout=40 "$HOST_SSH" \
    "powershell -NoProfile -ExecutionPolicy Bypass -File C:\\winfleet\\wf-rename.ps1 -Slot $1 -NameB64 $b64" \
    >/dev/null 2>&1 || true
}

# Nessuno di questi comandi puo' essere fatale: con set -e un ssh che torna non-zero
# ucciderebbe il sorvegliante, e la finestra sparirebbe senza una riga di log da
# nessuna parte. E' successo due volte, ed e' costato ore di caccia.
#
# Un comando ssh per richiesta, sulla connessione gia' aperta (ControlMaster): costa
# un paio di decimi, e le richieste partono solo quando la finestra si ferma. Un
# canale persistente con una pipe sarebbe stato piu' rapido, ma consegnava a
# singhiozzo senza dire perche' — e la parte che deve essere immediata (il ritaglio)
# non passa di qui: la scrive la libreria dentro il processo.
# L'indirizzo dell'agente si risolve UNA volta. Passare dal nome mDNS a ogni
# richiesta costa 230 ms contro i 19 dell'indirizzo numerico: era li' quasi tutta la
# latenza che si sentiva addosso al ridimensionamento.
agent_host(){
  if [ -n "${AGENT_HOST:-}" ]; then echo "$AGENT_HOST"; return; fi
  local h=""
  if [ -n "$HOST_LAN" ] && reachable "$HOST_LAN" "$AGENT_PORT" 1; then
    h="$HOST_LAN"
  elif [ -n "$HOST_NAME" ]; then
    h="$(dscacheutil -q host -a name "${HOST_NAME%.local}.local" 2>/dev/null | awk '/^ip_address/{print $2; exit}')"
    [ -n "$h" ] || h="$HOST_NAME"
  fi
  [ -n "$h" ] || h="$HOST_TS"
  AGENT_HOST="$h"
  echo "$h"
}

rect_set(){ # slot larghezza altezza -> stampa la misura DAVVERO applicata
  curl -s --max-time 2 "http://$(agent_host):$AGENT_PORT/rect?slot=$1&w=$2&h=$3" 2>/dev/null
}


vdd_set(){ # slot LARGHEZZAxALTEZZA
  need_ssh
  ssh "${SSH_OPTS[@]}" -o ConnectTimeout=10 "$HOST_SSH" \
    "powershell -NoProfile -Command \"'$1 $2' | Set-Content C:\\winfleet\\vdd-request.txt\"" >/dev/null 2>&1 || true
}

# ---------------------------------------------------------------------------
# Stato delle finestre aperte
# ---------------------------------------------------------------------------
# Una finestra aperta e' un ciclo di supervisione con dentro uno stream: il file
# tiene insieme i due pid piu' cosa sta mostrando, cosi' "windows", "fit" e "stop"
# parlano della finestra e non del processo.
slot_file(){ echo "$CONFIG_DIR/slot$1.state"; }

# Pid della shell corrente anche dentro una sottoshell, dove $$ resta quello del
# padre. BASHPID lo direbbe, ma non esiste sul bash 3.2 di serie su macOS.
# Il pid della subshell che sta girando, non quello del processo principale.
#
# $$ dentro una subshell resta il pid del padre - e' documentato e sorprende
# comunque. Il vecchio "exec sh -c 'echo $PPID'" cercava di aggirarlo ma restituiva
# a sua volta il padre della sh, cioe' ancora il processo principale: il numero
# salvato come "supervisore" era di qualcun altro, e ucciderlo non fermava niente.
# Sintomo: la finestra chiusa dal Mac restava aperta e lo slot occupato per sempre.
self_pid(){ echo "${BASHPID:-$$}"; }

slot_save(){ # slot app modalita pid-stream pid-supervisore
  printf 'app=%s\nmode=%s\npid=%s\nsup=%s\n' "$2" "$3" "$4" "$5" >"$(slot_file "$1")"
}

slot_get(){ # slot campo
  sed -n "s/^$2=//p" "$(slot_file "$1")" 2>/dev/null | tail -1
}

slot_live(){ # slot -> 0 se la finestra e' viva
  local sup pid; sup="$(slot_get "$1" sup)"; pid="$(slot_get "$1" pid)"
  [ -n "$sup" ] || return 1
  # Lo stream morto vuol dire finestra chiusa, comunque stia il supervisore: e' il
  # caso della X, dove il supervisore e' ancora vivo per qualche istante mentre
  # raccoglie la misura finale. Senza questo, per quegli istanti lo slot risulta
  # occupato da una finestra che non esiste piu' - e se il supervisore muore male,
  # per sempre.
  if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then
    kill "$sup" 2>/dev/null
    slot_forget "$1" 2>/dev/null
    return 1
  fi
  # Un supervisore morto lascia dietro il suo file di stato: se il processo non c'e'
  # piu' lo stato e' spazzatura e va tolto subito, non semplicemente ignorato.
  # Ignorarlo bastava per rispondere alla domanda "e' viva?", ma lasciava lo slot
  # occupato per chiunque leggesse il file dopo - compreso il pannello, che elencava
  # finestre aperte che non esistevano.
  if ! kill -0 "$sup" 2>/dev/null; then slot_forget "$1" 2>/dev/null; return 1; fi
  # I numeri di processo si riusano: dopo un riavvio del Mac quel numero e' di
  # qualcun altro, e una finestra "viva" che non esiste tiene occupato lo slot per
  # sempre — con "tutte le finestre sono occupate" al posto di una finestra.
  if ! ps -o command= -p "$sup" 2>/dev/null | grep -q winfleet; then
    slot_forget "$1" 2>/dev/null; return 1
  fi
}

slot_forget(){ rm -f "$(slot_file "$1")"; }

raise_window(){ # pid
  [ -n "${1:-}" ] || return 0
  osascript -e "tell application \"System Events\" to set frontmost of (first process whose unix id is $1) to true" \
    >/dev/null 2>&1 || true
}

# ---------------------------------------------------------------------------
# Bundle per app (Dock, ⌘-Tab, menu)
# ---------------------------------------------------------------------------
# Lo stream lo disegna Moonlight, quindi Dock, ⌘-Tab e barra dei menu portano il
# suo nome e la sua icona. Una copia di Moonlight.app intestata all'app risolve:
# stesso binario, identita' diversa. Su APFS la copia e' un clone, cioe' istantanea
# e senza occupare spazio.
RUNNERS="$CONFIG_DIR/runners"

runner_bin(){ # nome app -> binario da usare per lo stream
  local b="$RUNNERS/$1.app/Contents/MacOS/Moonlight"
  [ -x "$b" ] && echo "$b" || echo "$MOONLIGHT"
}

# Ogni app ha bisogno del suo bundle, non solo quelle messe nel Dock: senza, lo stream
# lo fa il Moonlight generico, che non riceve la libreria e quindi non ha il ritaglio
# — e al posto della sola finestra si vede tutto lo schermo virtuale, desktop
# compreso. Si crea alla prima apertura e resta.
ensure_runner(){ # nome exe
  # Anche un bundle che c'e' gia' va rifatto se e' di una versione precedente: si
  # riconosce dal programma d'ingresso che non ha (wf-open). Senza quello un doppio
  # click apre Moonlight invece dell'app, e con le chiavi di gioco di Moonlight
  # l'app finisce fra i videogiochi.
  [ -x "$RUNNERS/$1.app/Contents/MacOS/Moonlight" ] && \
    [ -x "$RUNNERS/$1.app/Contents/MacOS/wf-open" ] && return 0
  local icns="$CONFIG_DIR/icons/$1.icns"
  mkdir -p "$CONFIG_DIR/icons"
  [ -f "$icns" ] || build_icns "$1" "$2" "$icns" || icns=""
  build_runner "$1" "$icns" || return 1
}

# ---------------------------------------------------------------------------
# Via la barra del titolo di macOS
# ---------------------------------------------------------------------------
# L'app di Windows disegna gia' la sua barra dentro l'area client (Telegram, Edge e
# chiunque abbia un frame proprio), e da lato Windows non si toglie: restavano due
# barre sovrapposte. Quella di troppo e' quella del Mac, e si toglie iniettando una
# libreria nel processo che disegna la finestra — possibile solo perche' e' una
# NOSTRA copia di Moonlight, rifirmata ad-hoc: l'originale ha il runtime irrigidito
# e l'iniezione verrebbe (giustamente) rifiutata.
CHROME="${CHROME:-hidden}"   # "native" per riavere la barra del Mac
CHROME_LIB="$CONFIG_DIR/wf-chrome.dylib"

# Si compila di lato e si sposta a posto solo alla fine: dyld ammazza il processo
# senza appello se la libreria da iniettare non e' caricabile, e compilare sul posto
# lascia una finestra di tempo in cui il file c'e' ma e' mezzo scritto — chi lancia
# uno stream in quell'istante muore prima ancora di partire.
build_chrome(){
  local src tmp; src="$WF_ROOT/mac/wf-chrome.m"
  [ -f "$src" ] || return 1
  command -v clang >/dev/null 2>&1 || return 1
  [ -f "$CHROME_LIB" ] && [ "$CHROME_LIB" -nt "$src" ] && return 0
  tmp="$CHROME_LIB.new.$$"
  clang -dynamiclib -framework Cocoa -o "$tmp" "$src" >/dev/null 2>&1 || { rm -f "$tmp"; return 1; }
  codesign --force -s - "$tmp" >/dev/null 2>&1 || true
  mv -f "$tmp" "$CHROME_LIB"
}

# L'iniezione vale solo per i bundle per app: sull'originale in /Applications non
# funzionerebbe, e li' la barra del Mac resta (e occupa i suoi punti).
chrome_hidden(){ # binario dello stream
  [ "$CHROME" != native ] || return 1
  [ -f "$CHROME_LIB" ] || return 1
  case "$1" in "$RUNNERS"/*) return 0;; *) return 1;; esac
}

# ---------------------------------------------------------------------------
# Catalogo delle app installate sull'host
# ---------------------------------------------------------------------------
HOST_APPS="$CONFIG_DIR/host-apps.tsv"

# Una connessione sola, riusata da tutti i comandi: cambiare risoluzione mentre si
# trascina significa parlare con l'host di continuo, e rifare l'handshake ogni volta
# aggiungeva mezzo secondo a ogni passo.
SSH_OPTS=( -o BatchMode=yes -o ControlMaster=auto -o ControlPersist=120
           -o "ControlPath=$HOME/.config/winfleet/ssh-%r@%h:%p" )

need_ssh(){
  [ -n "${HOST_SSH:-}" ] || die "Serve l'accesso SSH all'host per cercare e registrare app.
Aggiungi a $CONFIG:   HOST_SSH=\"utente@indirizzo\""
}

host_ps(){ ssh -o BatchMode=yes -o ConnectTimeout=10 "$HOST_SSH" \
            "powershell -NoProfile -ExecutionPolicy Bypass -File C:\\winfleet\\$1" 2>/dev/null | tr -d '\r'; }

# Gli script dell'host vivono nel repo e devono arrivare sul PC. Si passa da base64
# perche' fra ssh, cmd e PowerShell qualsiasi cosa non sia [A-Za-z0-9+/=] rischia di
# essere reinterpretata per strada.
cmd_push(){
  need_ssh
  local src f n=0
  src="$WF_ROOT/host"
  [ -d "$src" ] || die "Non trovo la cartella host/ in $WF_ROOT."
  ssh -o BatchMode=yes -o ConnectTimeout=10 "$HOST_SSH" \
    "powershell -NoProfile -Command \"New-Item -ItemType Directory -Force -Path C:\\winfleet | Out-Null\"" >/dev/null 2>&1
  for f in "$src"/*.ps1; do
    base64 < "$f" | tr -d '\n' | ssh -o BatchMode=yes -o ConnectTimeout=20 "$HOST_SSH" \
      "powershell -NoProfile -Command \"[IO.File]::WriteAllBytes('C:\\winfleet\\$(basename "$f")', [Convert]::FromBase64String([Console]::In.ReadToEnd()))\"" \
      >/dev/null 2>&1 || { bad "$(basename "$f")"; continue; }
    n=$(( n + 1 ))
  done
  ok "$n script in C:\\winfleet sull'host"

  # Uno script caricato a meta' si scopre solo quando serve, di solito nel mezzo di
  # qualcos'altro: meglio saperlo adesso.
  local bad_files
  bad_files="$(ssh -o BatchMode=yes -o ConnectTimeout=20 "$HOST_SSH" \
    'powershell -NoProfile -Command "foreach($f in Get-ChildItem C:\winfleet\*.ps1){ $e=$null; [void][System.Management.Automation.Language.Parser]::ParseFile($f.FullName,[ref]$null,[ref]$e); if($e.Count){ Write-Host $f.Name } }"' \
    2>/dev/null | tr -d '\r' | grep -v '^$' || true)"
  [ -z "$bad_files" ] && ok "sintassi verificata sull'host" || { printf '%s\n' "$bad_files" | while read -r b; do bad "$b non compila sull'host"; done; return 1; }
}

cmd_scan(){
  need_ssh
  info "scansione delle app installate sull'host…"
  host_ps scan-apps.ps1 | grep -v '^$' | sort -f >"$HOST_APPS"
  ok "$(wc -l <"$HOST_APPS" | tr -d ' ') app trovate  ${c_dim}($HOST_APPS)${c_off}"
}

cmd_search(){
  need_ssh
  [ -s "$HOST_APPS" ] || cmd_scan
  local q="${*:-}"
  local matches; matches=$(grep -i -- "$q" "$HOST_APPS" 2>/dev/null || true)
  [ -n "$matches" ] || die "Nessuna app trovata per «${q}».  Prova:  winfleet scan"

  local n; n=$(printf '%s\n' "$matches" | wc -l | tr -d ' ')
  local pick
  if [ "$n" -eq 1 ]; then
    pick="$matches"
  else
    printf "${c_bold}App che corrispondono a «%s»${c_off}\n" "$q"
    printf '%s\n' "$matches" | nl -w3 -s'. ' | while IFS=$'\t' read -r left _; do printf "  %s\n" "$left"; done
    printf "Quale? [1-%d] " "$n"; read -r sel </dev/tty
    pick=$(printf '%s\n' "$matches" | sed -n "${sel}p")
    [ -n "$pick" ] || die "Selezione non valida."
  fi

  local name path
  name="${pick%%$'\t'*}"; path="${pick#*$'\t'}"
  # L'eseguibile scelto qui vince sulla ricerca per nome nel catalogo: due voci
  # possono chiamarsi uguale, e quella indicata e' questa.
  PICKED_EXE="$path" cmd_open "$name"
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------
cmd_endpoint(){
  need_config
  read -r addr kind <<<"$(resolve_endpoint)"
  [ -n "$addr" ] || die "Host irraggiungibile (LAN e Tailscale). PC acceso? Sunshine attivo?"
  printf "%s  ${c_dim}(%s)${c_off}\n" "$addr" "$kind"
}

cmd_open(){
  need_config
  local app="${1:-Desktop}"

  # Con le istanze a monitor virtuale ogni app ha il suo schermo: piu' finestre
  # insieme, e ridimensionarle cambia davvero la risoluzione lato Windows.
  if [ "${SLOTS:-0}" -gt 0 ] && [ -n "$HOST_NAME" ] && [ "$app" != "Desktop" ]; then
    local slot key want mode
    # Un'app gia' aperta si porta davanti, non si apre due volte. Senza questo, ogni
    # click sull'icona nel Dock lascia un secondo sorvegliante che si contende lo
    # stesso schermo: le due sessioni si buttano giu' a vicenda e da fuori sembra che
    # la finestra crashi in continuazione.
    local j
    for j in $(seq 0 $(( SLOTS - 1 ))); do
      if slot_live "$j" && [ "$(slot_get "$j" app)" = "$app" ]; then
        raise_window "$(slot_get "$j" pid)"
        # «${app}» e non «$app»: bash si mangia i byte di » dentro il nome.
        info "«${app}» è già aperta nella finestra $(( j + 1 ))"
        return
      fi
    done

    # Un'istanza che non risponde non e' un'istanza occupata: a PC spento il
    # messaggio giusto e' che il PC e' spento, non di chiudere finestre che non
    # esistono.
    slot="$(pick_slot)" || {
      read -r addr _ <<<"$(resolve_endpoint)"
      [ -n "$addr" ] || die "Host irraggiungibile (LAN e Tailscale). PC acceso?  winfleet doctor"
      die "Tutte le $SLOTS finestre sono occupate.  winfleet windows"
    }
    refresh_vdd
    local exe="${PICKED_EXE:-}"
    [ -n "$exe" ] || exe="$(app_exe "$app")" || true
    [ -n "$exe" ] || die "Non so quale eseguibile sia «${app}» sull'host.  winfleet scan"
    build_chrome || true
    ensure_runner "$app" "$exe" || info "senza bundle per «${app}»: niente ritaglio"
    # Senza barra del titolo la finestra E' il video: niente punti da scalare, e va
    # deciso prima di ogni calcolo di geometria.
    chrome_hidden "$(runner_bin "$app")" && TITLEBAR=0

    key="$(slug "$app")"
    want="$(sed -n "s/^size_$key=\"\{0,1\}\([0-9]*x[0-9]*\).*/\1/p" "$CONFIG" 2>/dev/null | tail -1)"
    local cap; cap="$(usable_screen "$(stream_pid)")"
    if [ -z "$want" ]; then
      # Prima apertura: una finestra che sta comoda su questo schermo, non la
      # risoluzione con cui il monitor virtuale si e' acceso.
      want="$(( ${cap%x*} * 7 / 10 ))x$(( ${cap#*x} * 7 / 10 ))"
    fi
    # La sessione si negozia alla misura piu' grande che sta su questo schermo, e non
    # si rinegozia piu': da li' in poi a seguire la finestra e' la risoluzione di
    # Windows, che cambia a caldo. La finestra parte dalla misura ricordata, con le
    # stesse proporzioni dello stream — altrimenti Sunshine ci mette le bande nere.
    mode="$(nearest_mode "$slot" "${cap%x*}" "${cap#*x}" "${cap%x*}" "${cap#*x}")"
    [ -n "$mode" ] || die "Il monitor virtuale non espone modalita': l'host ha winfleet-vdd attivo?"
    local ww="${want%x*}"
    [ "$ww" -gt "${mode%x*}" ] && ww="${mode%x*}"
    want="${ww}x$(( ww * ${mode#*x} / ${mode%x*} ))"

    local exe="${PICKED_EXE:-}"
    [ -n "$exe" ] || exe="$(app_exe "$app")" || true
    [ -n "$exe" ] || die "Non so quale eseguibile sia «${app}» sull'host.  winfleet scan"
    build_chrome || true
    ensure_runner "$app" "$exe" || info "senza bundle per «${app}»: niente ritaglio"

    # Senza barra del titolo la finestra E' il video: niente punti da scalare.
    chrome_hidden "$(runner_bin "$app")" && TITLEBAR=0
    printf "${c_dim}%s → finestra %d…${c_off}\n" "$app" "$(( slot + 1 ))"
    # In una subshell propria e con la gestione dei segnali attiva: senza, un kill al
    # supervisore lo faceva sparire lasciando dietro lo stream e il file di stato -
    # lo slot restava "occupato" con lo schermo vuoto davanti.
    # Via la misura del giro precedente PRIMA di lanciare il supervisore: e' il
    # segnale che si aspetta, e trovarne una vecchia significa dichiarare aperta una
    # finestra che non esiste ancora. Il supervisore la ricancella per conto suo, ma
    # qualche decimo di secondo dopo - e in quei decimi l'attesa e' gia' finita.
    rm -f "$CONFIG_DIR/slot$slot.size" 2>/dev/null || true
    ( WF_SUP=1 supervise_window "$slot" "$app" "$mode" "$key" "$exe" "$want" ) >/dev/null 2>&1 &
    WF_SUP_PID=$!
    # La finestra risulta presa da subito: il supervisore ci mette qualche secondo
    # ad arrivare allo stream, e nel frattempo un secondo "open" la sceglierebbe.
    slot_save "$slot" "$app" "$mode" "" "$WF_SUP_PID"
    disown 2>/dev/null || true

    # Si aspetta che la finestra ci sia davvero. Il segnale e' il file della misura,
    # che la libreria dentro il processo scrive quando la finestra e' sullo schermo:
    # e' l'unico momento in cui "aperta" e' vero. Il limite di tempo e' generoso
    # perche' la prima apertura di un'app su Windows puo' essere lenta, ma non
    # infinito: se non arriva si dice, invece di restare li'.
    local i sz=""
    # 45 secondi al massimo (90 mezzi secondi): la prima apertura di un'app su
    # Windows puo' essere lenta, ma un comando che non torna mai e' peggio di uno
    # che dice "non ce l'ha fatta".
    # Si aspetta la FINESTRA, chiedendola a macOS. Il file della misura sembrava il
    # segnale naturale ma non lo e': il supervisore lo cancella e lo ricrea per conto
    # suo, quindi leggerlo qui e' una corsa fra due processi - quello del giro
    # precedente veniva letto come se fosse gia' pronto, e "aperta" tornava a essere
    # una bugia detta mezzo secondo dopo invece che subito.
    local dead=0
    for i in $(seq 1 90); do
      sleep 0.5
      # La misura si legge dal file che scrive la libreria dentro Moonlight, non con
      # AppleScript: chiedere la geometria a System Events richiede il permesso di
      # Accessibilita', che l'utente puo' non aver dato (o che macOS revoca quando il
      # binario cambia firma, come succede a ogni ricompilazione). Senza quel
      # permesso osascript non fallisce in modo visibile: risponde vuoto, e l'attesa
      # scadeva sempre su finestre che si erano aperte benissimo.
      # "|| true" non e' pignoleria: con set -e attivo, un'assegnazione il cui
      # comando fallisce (il file non c'e' ancora, che e' il caso NORMALE mentre si
      # aspetta) termina la funzione. L'attesa moriva al primo giro, sempre, e il
      # comando tornava dopo un secondo e mezzo senza dire niente.
      sz="$(cat "$CONFIG_DIR/slot$slot.size" 2>/dev/null || true)"
      # Niente "case ... break": dentro un case, break esce dal case e non dal ciclo,
      # quindi il for continuava a girare e riazzerava la misura appena trovata - il
      # comando finiva senza dire niente su una finestra che si era aperta benissimo.
      # Un "case" il cui ultimo ramo assegna una stringa vuota esce con stato 1, e
      # con "set -e" attivo quello basta a terminare la funzione: l'attesa moriva al
      # primo giro, sempre, e il comando tornava senza dire niente. Con un if il
      # valore di uscita e' quello del test, non dell'assegnamento.
      if [ -n "${sz:-}" ] && [ "$sz" != "${sz#*x}" ]; then break; fi
      sz=""
      # Il supervisore si ricontrolla dallo stato dello slot, non da una variabile:
      # e' lui stesso a riscrivere il file col proprio pid appena parte, e quello e'
      # l'unico numero che vale. Un giro di grazia perche' la misura e la fine del
      # processo possono capitare nello stesso mezzo secondo.
      # I primi secondi non si giudica: il supervisore sta ancora scrivendo il
      # proprio pid nello stato, e slot_live risponde "morto" a una finestra che sta
      # nascendo. Chiedere troppo presto significa dichiarare fallita ogni apertura.
      if [ "$i" -gt 8 ]; then
        if slot_live "$slot" 2>/dev/null; then
          dead=0
        else
          dead=$(( dead + 1 ))
          [ "$dead" -ge 3 ] && break
        fi
      fi
    done

    if [ -n "$sz" ]; then
      printf "${c_bold}%s${c_off} → finestra %d sul Mac  ${c_dim}(%s, %s, %d fps)${c_off}\n" \
        "$app" "$(( slot + 1 ))" "$HOST_NAME" "$sz" "$FPS"
      return 0
    fi
    if kill -0 "$WF_SUP_PID" 2>/dev/null; then
      # «${app}» e non «$app»: » sono due byte che bash attacca al nome della
      # variabile, e sotto set -u il messaggio d'errore muore invece di dirti
      # cosa non e' andato. La regola era gia' scritta 120 righe sopra, ma qui
      # non era stata applicata: proprio nei due rami che spiegano un fallimento.
      bad "«${app}» non ha aperto una finestra entro 45 secondi (ci sta ancora provando)"
    else
      bad "«${app}» non si e' aperta.  winfleet doctor"
    fi
    return 1
  fi

  read -r addr kind <<<"$(resolve_endpoint)"
  [ -n "$addr" ] || die "Host irraggiungibile. Controlla:  winfleet doctor"

  # Moonlight risolve il nome dell'app dalla lista che ha in cache: se l'app è
  # stata registrata da poco, senza un refresh risponde "Failed to find application".
  "$MOONLIGHT" list "$addr" >/dev/null 2>&1 || true

  local res br
  res="$(stream_res)"
  br="$(stream_bitrate "$res")"

  local args=( stream "$addr" "$app"
    --display-mode windowed
    --fps "$FPS" --bitrate "$br"
    --absolute-mouse --no-vsync --quit-after )
  [ -n "$res" ] && args+=( --resolution "$res" )

  printf "${c_bold}%s${c_off} → finestra sul Mac  ${c_dim}(%s, %s, %s, %d fps, %s Mbps)${c_off}\n" \
    "$app" "$addr" "$kind" "${res:-nativa}" "$FPS" "$(( br / 1000 ))"
  nohup "$MOONLIGHT" "${args[@]}" >"$CONFIG_DIR/stream-$$.log" 2>&1 &
  local mpid=$!
  disown || true

  # Alla prima connessione impariamo la risoluzione dell'host dal log di
  # Moonlight, così dal secondo stream in poi si va in nativa.
  local i
  for i in $(seq 1 40); do
    sleep 0.5
    [ -n "$res" ] && break
    res="$(detect_host_res || true)"
    [ -n "$res" ] && { save_cfg HOST_RES "$res"; info "risoluzione host rilevata: $res (attiva dal prossimo avvio)"; }
  done

  hide_gui "$mpid"
  [ -n "$res" ] && aspect_keeper "$mpid" "${res%x*}" "${res#*x}"
}

cmd_windows(){
  [ "${SLOTS:-0}" -gt 0 ] || { info "nessuna istanza a finestre configurata (SLOTS=0)"; return; }
  printf "${c_bold}Finestre${c_off}\n"
  local i st app size
  for i in $(seq 0 $(( SLOTS - 1 ))); do
    st="$(slot_state "$i" || true)"
    app=""; size=""
    if slot_live "$i"; then app="$(slot_get "$i" app)"; size="$(slot_get "$i" mode)"; fi
    [ -n "$size" ] || size="$(vdd_field "$i" width)x$(vdd_field "$i" height)"
    # Chi comanda e' lo stato locale, non quello che dice l'host. Sunshine
    # dichiara la sessione libera in due momenti in cui la finestra sul Mac c'e'
    # eccome: durante la negoziazione, e dopo un riavvio dell'istanza mentre il
    # client e' ancora connesso. Fidandosi solo dell'host, "winfleet windows"
    # elencava quattro finestre libere con due app aperte davanti agli occhi — e
    # peggio, la prossima "open" gliele sovrascriveva.
    if [ -n "$app" ]; then
      ok "finestra $(( i + 1 ))  $app  ${c_dim}$size${c_off}"
    else
      case "$st" in
        *FREE*) info "finestra $(( i + 1 ))  libera        ${c_dim}porta $(slot_port "$i")${c_off}";;
        *BUSY*) ok   "finestra $(( i + 1 ))  in uso        ${c_dim}$size (da un altro client)${c_off}";;
        *)      bad  "finestra $(( i + 1 ))  non risponde  ${c_dim}porta $(slot_port "$i")${c_off}";;
      esac
    fi
  done
}

# Chiude una finestra, o tutte. Il supervisore va fermato per primo: e' lui che
# riapre lo stream quando lo vede sparire, quindi ucciderlo dopo lo farebbe
# resuscitare una volta.
#
# I pid arrivano da un file su disco e possono essere STALE: su macOS i pid si
# riciclano, e sparare a un numero letto mezz'ora fa vuol dire sparare a chi
# quel numero ce l'ha adesso. Un pid vuoto sarebbe anche peggio - `kill ""` con
# certi shell degenera nel gruppo. Quindi: numero valido, o non si tira.
kill_if_sane(){ # pid
  local p="${1:-}"
  [ -n "$p" ] || return 0
  [ "$p" -gt 1 ] 2>/dev/null || return 0   # mai 0 (gruppo) ne' 1 (launchd)
  kill "$p" 2>/dev/null || true
}

close_slot(){ # slot
  local sup pid app; app="$(slot_get "$1" app)"
  sup="$(slot_get "$1" sup)"; pid="$(slot_get "$1" pid)"
  kill_if_sane "$sup"
  kill_if_sane "$pid"
  place_stop "$1"
  slot_forget "$1"
  ok "finestra $(( $1 + 1 )) chiusa${app:+  ${c_dim}($app)${c_off}}"
}

cmd_stop(){
  local i closed=0
  if [ -n "${1:-}" ]; then
    i=$(( $1 - 1 ))
    [ "$i" -ge 0 ] && [ "$i" -lt "${SLOTS:-0}" ] || die "Finestra $1 inesistente (ce ne sono ${SLOTS:-0})."
    close_slot "$i"; return
  fi
  for i in $(seq 0 $(( ${SLOTS:-0} - 1 ))); do
    slot_live "$i" || continue
    close_slot "$i"; closed=1
  done
  [ "$closed" = 1 ] && return

  need_config
  read -r addr kind <<<"$(resolve_endpoint)"
  # chiusura graceful della sessione lato host (meglio di uccidere il client:
  # lascia Sunshine libero per la prossima connessione)
  # Con un tetto di tempo e in secondo piano: "Moonlight quit" verso un host che non
  # ha una sessione attiva non torna mai, e resta li' per sempre. Se ne accumulava
  # uno per ogni "winfleet stop" chiamato a vuoto, e dal quinto in poi il comando si
  # bloccava - il sintomo era winfleet che non rispondeva piu' senza motivo.
  if [ -n "$addr" ]; then
    ( "$MOONLIGHT" quit "$addr" >/dev/null 2>&1 & 
      qp=$!
      ( sleep 8; kill "$qp" 2>/dev/null ) >/dev/null 2>&1 &
      wait "$qp" 2>/dev/null ) >/dev/null 2>&1 &
    disown 2>/dev/null || true
  fi
  pkill -f "Moonlight.*stream" 2>/dev/null || true
  echo "Sessione chiusa."
}

cmd_list(){
  need_config
  read -r addr kind <<<"$(resolve_endpoint)"
  [ -n "$addr" ] || die "Host irraggiungibile."
  "$MOONLIGHT" list "$addr" 2>/dev/null | grep -viE "Redirecting" || \
    info "nessuna app (l'host è accoppiato? winfleet pair)"
}

cmd_pair(){
  need_config
  read -r addr kind <<<"$(resolve_endpoint)"
  [ -n "$addr" ] || die "Host irraggiungibile."
  echo "Avvio pairing con $addr…"
  echo "Moonlight mostrerà un PIN: inseriscilo nella web UI di Sunshine"
  echo "  https://$addr:$SUN_PORT   →   PIN"
  "$MOONLIGHT" pair "$addr"
}

LAUNCHERS="$HOME/Applications/WinFleet"

cmd_apps(){
  [ -d "$LAUNCHERS" ] || { info "nessun lanciatore creato (winfleet dock <app>)"; return; }
  local n=0 a
  printf "${c_bold}App sul Mac${c_off}  ${c_dim}$LAUNCHERS${c_off}\n"
  for a in "$LAUNCHERS"/*.app; do
    [ -d "$a" ] || continue
    a="$(basename "$a" .app)"
    [ "$a" = WinFleet ] && continue          # il pannello, non un'app del PC
    n=$(( n + 1 ))
    printf "  • %s\n" "$a"
  done
  [ "$n" = 0 ] && info "nessun lanciatore creato (winfleet dock <app>)"
  return 0
}

# Icona dell'app di Windows, convertita in .icns. Il PNG arriva in base64 sopra la
# stessa connessione SSH che usiamo per tutto il resto: nessun file condiviso.
build_icns(){ # nome exe destinazione.icns
  local name="$1" exe="$2" out="$3"
  local tmp b64; tmp="$(mktemp -d)"
  b64="$(printf '%s' "$exe" | base64 | tr -d '\n')"
  ssh -o BatchMode=yes -o ConnectTimeout=20 "$HOST_SSH" \
    "powershell -NoProfile -ExecutionPolicy Bypass -File C:\\winfleet\\wf-icon.ps1 -PathB64 $b64" \
    2>/dev/null | tr -d '\r\n' | base64 -d >"$tmp/src.png" 2>/dev/null || true
  [ -s "$tmp/src.png" ] || { rm -rf "$tmp"; return 1; }

  mkdir -p "$tmp/i.iconset"
  local s
  for s in 16 32 128 256; do
    sips -z "$s" "$s" "$tmp/src.png" --out "$tmp/i.iconset/icon_${s}x${s}.png" >/dev/null 2>&1
    [ "$s" = 256 ] && continue
    sips -z "$(( s * 2 ))" "$(( s * 2 ))" "$tmp/src.png" \
      --out "$tmp/i.iconset/icon_${s}x${s}@2x.png" >/dev/null 2>&1
  done
  iconutil -c icns "$tmp/i.iconset" -o "$out" >/dev/null 2>&1 || { rm -rf "$tmp"; return 1; }
  rm -rf "$tmp"
}

# Una stringa che puo' finire dentro uno script di shell senza sorprese: i nomi delle
# app di Windows hanno spazi, apostrofi e accenti.
sh_quote(){ printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

# Moonlight e' un client di gioco, e lo dichiara: categoria "games", modalita' gioco,
# controller. Da macOS 26 quelle chiavi bastano perche' il sistema metta il bundle nel
# catalogo dell'app Giochi — e Telegram o Esplora file fra i videogiochi, oltre che
# sbagliato, li fa lanciare da li'. Le copie intestate a un'app non sono giochi:
# le chiavi si tolgono e la categoria diventa quella vera.
ungame_plist(){ # Info.plist nome
  local plist="$1" name="$2" pb=/usr/libexec/PlistBuddy k
  for k in LSApplicationCategoryType LSSupportsGameMode GCSupportsGameMode \
           GCSupportedGameControllers GCSupportsControllerUserInteraction; do
    "$pb" -c "Delete :$k" "$plist" >/dev/null 2>&1 || true
  done
  "$pb" -c "Add :LSApplicationCategoryType string public.app-category.utilities" \
    "$plist" >/dev/null 2>&1 || true
  # Anche la descrizione parlava di giochi, e si legge in Finder.
  "$pb" -c "Set :CFBundleGetInfoString $name, da Windows tramite WinFleet" "$plist" >/dev/null 2>&1 || \
    "$pb" -c "Add :CFBundleGetInfoString string $name, da Windows tramite WinFleet" "$plist" >/dev/null 2>&1 || true
}

# Aperto dal Finder, da Spotlight o dal Dock, un bundle per app deve aprire LA SUA
# finestra. Senza questo parte il binario di Moonlight cosi' com'e', che mostra il suo
# elenco di host: la finestra sbagliata, e nessuna app.
#
# Lo stream continua a partire dal binario, che winfleet lancia per percorso: il
# programma dichiarato nel bundle e' solo la porta d'ingresso di chi apre con un
# doppio click. L'identita' del processo (nome e icona in Dock e ⌘-Tab) resta quella
# del bundle in entrambi i casi.
runner_shim(){ # bundle nome
  local app="$1" name="$2" pb=/usr/libexec/PlistBuddy
  cat > "$app/Contents/MacOS/wf-open" <<SHIM
#!/bin/sh
exec $(sh_quote "$WF_SELF") open $(sh_quote "$name")
SHIM
  chmod +x "$app/Contents/MacOS/wf-open"
  "$pb" -c "Set :CFBundleExecutable wf-open" "$app/Contents/Info.plist" >/dev/null 2>&1 || \
    "$pb" -c "Add :CFBundleExecutable string wf-open" "$app/Contents/Info.plist" >/dev/null 2>&1 || \
    die "Non riesco a scrivere CFBundleExecutable in $app"
}

# Il catalogo dei giochi e' una cache che il sistema si tiene: finche' non la si
# butta, un bundle che ieri era un gioco resta fra i giochi anche dopo che le chiavi
# non ci sono piu'. Si ricostruisce da sola al primo avvio delle app vere.
LSREGISTER=/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister

winfleet_in_game_catalog(){
  defaults export com.apple.GamePolicyAgent - 2>/dev/null \
    | plutil -extract installedGames raw -o - - 2>/dev/null \
    | base64 -d 2>/dev/null | grep -a -q 'dev\.winfleet\.'
}

forget_games(){ # bundle...
  local app
  for app in "$@"; do
    [ -x "$LSREGISTER" ] && "$LSREGISTER" -f "$app" >/dev/null 2>&1 || true
  done
  winfleet_in_game_catalog || return 0
  defaults delete com.apple.GamePolicyAgent installedGames >/dev/null 2>&1 || true
  killall GamePolicyAgent >/dev/null 2>&1 || true
  info "tolte le app di WinFleet dal catalogo Giochi di macOS"
}

# Copia di Moonlight intestata all'app: e' il processo che disegna la finestra,
# quindi da lui dipendono nome e icona in Dock, ⌘-Tab e barra dei menu. Su APFS
# "cp -c" e' un clone: istantaneo e senza occupare spazio.
build_runner(){ # nome icns|""
  # Due righe e non una: "local a=$1 b=$a" non funziona, perche' local espande tutti
  # i suoi argomenti PRIMA di assegnarli e $a li' dentro e' ancora vuoto. Finora
  # reggeva solo perche' chi chiamava aveva per caso una variabile con lo stesso nome.
  local name="$1" icns="$2" pb=/usr/libexec/PlistBuddy
  local app="$RUNNERS/$name.app"
  [ -d "$MOONLIGHT_APP" ] || die "Moonlight non trovato in $MOONLIGHT_APP"
  rm -rf "$app"; mkdir -p "$RUNNERS"
  cp -Rc "$MOONLIGHT_APP" "$app" 2>/dev/null || cp -R "$MOONLIGHT_APP" "$app"

  local id plist k; id="$(slug "$name")"
  plist="$app/Contents/Info.plist"
  # Moonlight non ha CFBundleName: Set su una chiave assente fallisce e basta,
  # quindi ogni chiave va aggiunta se manca.
  for k in CFBundleName CFBundleDisplayName; do
    "$pb" -c "Set :$k $name" "$plist" >/dev/null 2>&1 || \
      "$pb" -c "Add :$k string $name" "$plist" >/dev/null 2>&1 || \
      die "Non riesco a scrivere $k in $plist"
  done
  "$pb" -c "Set :CFBundleIdentifier dev.winfleet.runner.$id" "$plist" >/dev/null 2>&1 || \
    "$pb" -c "Add :CFBundleIdentifier string dev.winfleet.runner.$id" "$plist" >/dev/null 2>&1 || true

  if [ -n "$icns" ] && [ -f "$icns" ]; then
    local f; f="$("$pb" -c 'Print :CFBundleIconFile' "$plist" 2>/dev/null || true)"
    f="${f%.icns}.icns"; [ "$f" != ".icns" ] || f=icon.icns
    cp "$icns" "$app/Contents/Resources/$f"
    "$pb" -c "Set :CFBundleIconFile $f" "$plist" >/dev/null 2>&1 || \
      "$pb" -c "Add :CFBundleIconFile string $f" "$plist" >/dev/null 2>&1 || true
  fi

  ungame_plist "$plist" "$name"
  runner_shim "$app" "$name"

  # Su Apple Silicon la firma del binario sigilla anche Info.plist: dopo averlo
  # toccato il bundle non parte finché non lo si rifirma.
  codesign --force --deep --sign - "$app" >/dev/null 2>&1 || \
    die "Non riesco a rifirmare $app (serve per farlo partire su Apple Silicon)."
  forget_games "$app"
}

# Lanciatore da Dock/Spotlight: apre la finestra e sparisce, il resto lo fa il
# runner. Separato apposta, così quello che resta in ⌘-Tab è uno solo.
build_launcher(){ # nome icns|""
  local name="$1" icns="$2" self
  local app="$LAUNCHERS/$name.app"
  self="$WF_SELF"
  rm -rf "$app"
  mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
  cat > "$app/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleName</key><string>$name</string>
  <key>CFBundleDisplayName</key><string>$name</string>
  <key>CFBundleIdentifier</key><string>dev.winfleet.$(slug "$name")</string>
  <key>CFBundleExecutable</key><string>launch</string>
  <key>CFBundleIconFile</key><string>icon</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>1.0</string>
  <key>LSApplicationCategoryType</key><string>public.app-category.utilities</string>
  <key>LSUIElement</key><true/>
</dict></plist>
PLIST
  cat > "$app/Contents/MacOS/launch" <<LAUNCH
#!/bin/sh
exec $(sh_quote "$self") open $(sh_quote "$name")
LAUNCH
  chmod +x "$app/Contents/MacOS/launch"
  [ -n "$icns" ] && [ -f "$icns" ] && cp "$icns" "$app/Contents/Resources/icon.icns"
  codesign --force --sign - "$app" >/dev/null 2>&1 || true
  touch "$app"   # LaunchServices rilegge il bundle
  forget_games "$app"
}

# Il pannello: un\'app in barra dei menu con la tendina. Si costruisce come la
# libreria — sorgente nel repo, binario fuori — e si apre da solo se non gira gia\'.
PANEL_APP="$HOME/Applications/WinFleet/WinFleet.app"
DOCK_APP="$HOME/Applications/WinFleet/WinFleet Dock.app"

build_panel(){
  local src="$WF_ROOT/mac/wf-panel.m"
  [ -f "$src" ] || return 1
  command -v clang >/dev/null 2>&1 || return 1
  local bin="$PANEL_APP/Contents/MacOS/WinFleet"
  [ -x "$bin" ] && [ "$bin" -nt "$src" ] && return 0
  mkdir -p "$PANEL_APP/Contents/MacOS" "$PANEL_APP/Contents/Resources"
  cat > "$PANEL_APP/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleName</key><string>WinFleet</string>
  <key>CFBundleDisplayName</key><string>WinFleet</string>
  <key>CFBundleIdentifier</key><string>dev.winfleet.panel</string>
  <key>CFBundleExecutable</key><string>WinFleet</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>1.0</string>
  <key>LSUIElement</key><true/>
</dict></plist>
PLIST
  clang -framework Cocoa -o "$bin.new" "$src" >/dev/null 2>&1 || { rm -f "$bin.new"; return 1; }
  mv -f "$bin.new" "$bin"
  codesign --force -s - "$PANEL_APP" >/dev/null 2>&1 || true
}

# Il pannello nel Dock. E' un'app normale, non un LSUIElement: deve avere l'icona
# nel Dock, perche' e' li' che si va a cercare un'app da aprire.
build_dock_panel(){
  local src="$WF_ROOT/mac/wf-dock.m"
  [ -f "$src" ] || return 1
  command -v clang >/dev/null 2>&1 || return 1
  local bin="$DOCK_APP/Contents/MacOS/WinFleet Dock"
  [ -x "$bin" ] && [ "$bin" -nt "$src" ] && return 0
  mkdir -p "$DOCK_APP/Contents/MacOS" "$DOCK_APP/Contents/Resources"
  cat > "$DOCK_APP/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleName</key><string>WinFleet Dock</string>
  <key>CFBundleDisplayName</key><string>WinFleet</string>
  <key>CFBundleIdentifier</key><string>dev.winfleet.dock</string>
  <key>CFBundleExecutable</key><string>WinFleet Dock</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleIconFile</key><string>app.icns</string>
  <key>CFBundleShortVersionString</key><string>1.0</string>
  <key>NSHighResolutionCapable</key><true/>
</dict></plist>
PLIST
  # Un'icona propria. Prima si prendeva la prima icona trovata fra quelle scaricate
  # dall'host: il pannello finiva per avere l'icona di Telegram, che e' il tipo di
  # dettaglio che fa sembrare un programma messo insieme in fretta.
  cp -f "$WF_ROOT/mac/assets/wf-icon.icns" "$DOCK_APP/Contents/Resources/app.icns" 2>/dev/null || true
  clang -framework Cocoa -o "$bin.new" "$src" >/dev/null 2>&1 || { rm -f "$bin.new"; return 1; }
  mv -f "$bin.new" "$bin"
  codesign --force -s - "$DOCK_APP" >/dev/null 2>&1 || true
}

# Le icone di tutte le app, in un colpo solo. Estrarle una alla volta al momento del
# bisogno vuol dire un pannello che si riempie di icone mancanti, e ognuna costa un
# giro di SSH: con settanta app sono settanta connessioni. Qui si paga una volta.
cmd_icons(){
  need_ssh
  [ -s "$HOST_APPS" ] || cmd_scan
  mkdir -p "$CONFIG_DIR/icons"
  local name exe icns n=0 skip=0 fail=0 tot
  tot=$(wc -l < "$HOST_APPS" | tr -d ' ')
  info "estraggo le icone di $tot app dall'host…"
  while IFS=$'\t' read -r name exe; do
    [ -n "$name" ] && [ -n "$exe" ] || continue
    icns="$CONFIG_DIR/icons/$name.icns"
    # Gia' presente: non si rifa'. Le icone di Windows non cambiano da sole, e
    # rifarle tutte a ogni giro trasformerebbe un comando da usare in uno da evitare.
    [ -f "$icns" ] && { skip=$(( skip + 1 )); continue; }
    # </dev/null: ssh legge dallo standard input e si mangerebbe il resto del file
    # letto dal while, fermando il ciclo dopo la prima app. Sintomo: "1 icona nuova"
    # e nessun errore.
    if build_icns "$name" "$exe" "$icns" </dev/null; then
      n=$(( n + 1 ))
      printf "\r  ${c_dim}%d nuove, %d gia' presenti, %d senza icona${c_off}   " "$n" "$skip" "$fail"
    else
      fail=$(( fail + 1 ))
    fi
  done < "$HOST_APPS"
  printf "\r"
  ok "$n icone nuove  ${c_dim}($skip gia' c'erano, $fail senza icona estraibile)${c_off}"
}

cmd_dockpanel(){
  build_dock_panel || die "Non riesco a compilare il pannello del Dock (serve clang)."
  [ -s "$HOST_APPS" ] || { info "catalogo vuoto: lo costruisco"; cmd_scan; }
  # Le icone servono al pannello per essere leggibile: senza, e' un elenco di
  # settanta righe di testo. Si scaricano una volta, alla prima apertura.
  local nic=0
  [ -d "$CONFIG_DIR/icons" ] && nic=$(find "$CONFIG_DIR/icons" -name '*.icns' | wc -l | tr -d ' ')
  [ "$nic" -lt 10 ] && { info "scarico le icone delle app (si fa una volta sola)"; cmd_icons; }
  open "$DOCK_APP"
  ok "pannello nel Dock  ${c_dim}(clicca l'icona per app, finestre e ricerca)${c_off}"
}

cmd_panel(){
  build_panel || die "Non riesco a compilare il pannello (serve clang)."
  if pgrep -f "WinFleet.app/Contents/MacOS/WinFleet" >/dev/null 2>&1; then
    ok "il pannello e già in barra dei menu"
  else
    open "$PANEL_APP"
    ok "pannello aperto  ${c_dim}(icona in barra dei menu)${c_off}"
  fi
}

cmd_dock(){
  need_ssh
  [ -s "$HOST_APPS" ] || cmd_scan
  local names=("$@")
  if [ ${#names[@]} -eq 0 ]; then
    local a
    for a in "$LAUNCHERS"/*.app; do
      [ -d "$a" ] || continue
      a="$(basename "$a" .app)"
      [ "$a" = WinFleet ] && continue        # il pannello non e' un'app del PC
      names+=("$a")
    done
    [ ${#names[@]} -gt 0 ] || die "Uso: winfleet dock <app> [app...]     (i nomi sono quelli di: winfleet search)"
  fi

  mkdir -p "$CONFIG_DIR/icons"
  build_chrome || info "clang assente: la barra del titolo di macOS restera' visibile"
  local name exe icns
  for name in "${names[@]}"; do
    exe="$(app_exe "$name")" || true
    [ -n "$exe" ] || { bad "«${name}» non è tra le app dell'host (winfleet scan)"; continue; }
    icns="$CONFIG_DIR/icons/$name.icns"
    # Se l'icona non arriva dall'host (PC spento) vale quella gia' scaricata: senza
    # questo un secondo "dock" a PC spento cancellerebbe le icone di tutti.
    if build_icns "$name" "$exe" "$icns" || [ -f "$icns" ]; then :
    else icns=""; info "$name: icona non recuperata, resta quella di Moonlight"; fi
    build_runner "$name" "$icns"
    build_launcher "$name" "$icns"
    ok "$name  ${c_dim}$LAUNCHERS/$name.app${c_off}"
  done
  echo
  echo "Trascinali nel Dock: un click = la finestra dell'app, col suo nome e la sua icona."
}


# Moonlight tiene un elenco degli host conosciuti, e ogni istanza rifatta ne lascia
# dentro uno morto: restano in giro con l'icona di errore e confondono e basta.
# Si buttano quelli che non risponde piu' nessuno, mai quelli vivi.
MOON_PREFS="$HOME/Library/Preferences/com.moonlight-stream.Moonlight.plist"

cmd_clean(){
  pgrep -f "Moonlight" >/dev/null 2>&1 && \
    die "Moonlight è aperto: chiudi le finestre (winfleet stop) prima di ripulire l'elenco."
  [ -f "$MOON_PREFS" ] || die "Non trovo le preferenze di Moonlight ($MOON_PREFS)."

  cp "$MOON_PREFS" "$MOON_PREFS.winfleet-bak"
  local report
  report="$(MOON_PREFS="$MOON_PREFS" python3 - <<'PY'
import os, plistlib, re, urllib.request

path = os.environ["MOON_PREFS"]
with open(path, "rb") as f:
    d = plistlib.load(f)

n = int(d.get("hosts.size", 0) or 0)

def reported_uuid(host, port):
    """Chi risponde davvero a quell'indirizzo, o None se non risponde nessuno."""
    url = "http://%s:%d/serverinfo?uniqueid=winfleet" % (host, port)
    try:
        with urllib.request.urlopen(url, timeout=2) as r:
            body = r.read().decode("utf-8", "replace")
    except Exception:
        return None
    m = re.search(r"<uniqueid>([^<]+)</uniqueid>", body)
    return m.group(1).lower() if m else None

# Si butta solo cio' che si sa essere morto: l'indirizzo risponde, ma con un'altra
# identita' — allora quella voce e' il residuo di un'istanza rifatta. Un indirizzo
# che non risponde puo' essere semplicemente un PC spento, e resta dov'e'.
keep, drop = [], []
for i in range(1, n + 1):
    name = d.get("hosts.%d.hostname" % i, "?")
    saved = str(d.get("hosts.%d.uuid" % i, "")).lower()
    stale = False
    for a, p in (("hosts.%d.manualaddress" % i, "hosts.%d.manualport" % i),
                 ("hosts.%d.localaddress" % i, "hosts.%d.localport" % i)):
        host, port = d.get(a), d.get(p)
        if not host or not port:
            continue
        live = reported_uuid(host, int(port))
        if live is None:
            continue
        stale = live != saved
        break
    (drop if stale else keep).append((i, name))

# Le voci sono numerate: rimuoverne una in mezzo senza rinumerare le successive le
# renderebbe invisibili a Qt, che si ferma al primo buco.
old = {k: v for k, v in d.items() if k.startswith("hosts.")}
for k in old:
    del d[k]
for new, (i, _) in enumerate(keep, start=1):
    pre = "hosts.%d." % i
    for k, v in old.items():
        if k.startswith(pre):
            d["hosts.%d.%s" % (new, k[len(pre):])] = v
d["hosts.size"] = len(keep)

with open(path, "wb") as f:
    plistlib.dump(d, f)

for _, name in keep:
    print("tenuto\t%s" % name)
for _, name in drop:
    print("rimosso\t%s" % name)
PY
)" || { mv "$MOON_PREFS.winfleet-bak" "$MOON_PREFS"; die "Pulizia fallita: preferenze ripristinate."; }

  # cfprefsd tiene le preferenze in memoria e riscriverebbe sopra le nostre.
  killall -u "$USER" cfprefsd 2>/dev/null || true

  printf '%s\n' "$report" | while IFS=$'\t' read -r what name; do
    [ "$what" = tenuto ] && ok "$name" || info "rimosso  $name"
  done
  echo
  info "copia di sicurezza: $MOON_PREFS.winfleet-bak"
}

# Le schede di rete del PC marcate "Pubblica". Lo script PowerShell sta in un
# heredoc e non in una stringa: annidare virgolette per shell, ssh e PowerShell
# insieme produce righe che sembrano giuste e non lo sono — questa qui aveva un
# apice che chiudeva la stringa a meta' e rompeva l'intero file, ma solo quando
# lanciato da un'altra shell.
public_nics_on_host(){
  [ -n "$HOST_SSH" ] || return 0
  # Lo script PowerShell sta in una variabile normale, non in un heredoc dentro
  # $(...): quella forma rompe il parser di bash - l'errore che riporta e' "EOF
  # cercando un apice" alla FINE del file, cioe' a duecento righe di distanza da
  # dove sta il problema, e l'intero comando smette di funzionare.
  # Gli apici sono doppi fuori e singoli dentro, senza annidamenti.
  local ps="Get-NetConnectionProfile | Where-Object { \$_.NetworkCategory -eq 'Public' -and \$_.InterfaceAlias -notmatch 'Tailscale' } | ForEach-Object { \$_.InterfaceAlias }"
  printf '%s' "$ps" | ssh -o BatchMode=yes -o ConnectTimeout=6 "$HOST_SSH" \
      "powershell -NoProfile -Command -" 2>/dev/null | tr -d '\r' | tr '\n' ' ' | sed 's/ *$//'
}

# Rimette private le schede del PC: e' l'unica cosa che separa uno stream nero da
# uno che funziona, e va fatta ogni volta che Windows vede una rete nuova.
cmd_fixnet(){
  need_ssh
  local pub; pub="$(public_nics_on_host)"
  [ -n "$pub" ] || { ok "le reti del PC sono gia' private"; return; }
  local n
  for n in $pub; do
    ssh -o BatchMode=yes -o ConnectTimeout=8 "$HOST_SSH" \
      "powershell -NoProfile -Command \"Set-NetConnectionProfile -InterfaceAlias '$n' -NetworkCategory Private\"" >/dev/null 2>&1 \
      && ok "rete '$n' ora privata" || bad "non riesco a cambiare '$n' (serve un terminale da amministratore sul PC)"
  done
}

# La sessione bloccata e' il guasto piu' insidioso del sistema: quando Windows blocca
# lo schermo la sessione grafica si riduce, i monitor virtuali smettono di disegnare e
# ogni finestra diventa un rettangolo nero. Da fuori sembra un problema di stream.
#
# Non e' diagnosticabile da SSH nel modo ovvio: una sessione SSH non vede il desktop,
# e chiedere gli schermi da li' restituisce sempre un finto "1024x768 WinDisc" anche
# quando va tutto bene. Bisogna guardare la presenza di LogonUI, che e' il processo
# della schermata di blocco.
host_locked(){
  [ -n "$HOST_SSH" ] || return 1
  local n
  n="$(ssh -o BatchMode=yes -o ConnectTimeout=6 "$HOST_SSH" \
       'powershell -NoProfile -Command "(Get-Process LogonUI -EA SilentlyContinue|Measure-Object).Count"' 2>/dev/null | tr -d '\r ')"
  [ "${n:-0}" != "0" ]
}

cmd_unlock(){
  need_ssh
  host_locked || { ok "la sessione del PC e' gia' sbloccata"; return; }
  info "la sessione e' bloccata: senza sbloccarla le finestre restano nere"
  # Non c'e' modo di sbloccare Windows da remoto senza la password: il blocco esiste
  # apposta. Quello che si puo' fare e' togliere il motivo per cui si e' bloccata,
  # cosi' che non ricapiti dopo che l'hai sbloccata a mano una volta.
  ssh -o BatchMode=yes -o ConnectTimeout=10 "$HOST_SSH" \
      'schtasks /run /tn wf-nolock' >/dev/null 2>&1 \
    && ok "blocco automatico disattivato (non si ribloccera' da solo)" \
    || bad "non riesco a disattivare il blocco automatico: winfleet push, poi riprova"
  info "adesso sblocca il PC a mano una volta: e' l'unica cosa che la password protegge"
}

cmd_doctor(){
  printf "${c_bold}WinFleet doctor${c_off}\n"
  [ -f "$CONFIG" ] && ok "config: $CONFIG" || bad "config assente: $CONFIG (winfleet setup)"
  [ -x "$MOONLIGHT" ] && ok "Moonlight: $MOONLIGHT" || bad "Moonlight non trovato (brew install --cask moonlight)"
  [ -n "${SCREEN:-}" ] && ok "schermo utile: $SCREEN" || info "schermo non ancora misurato (si misura alla prima finestra)"
  if [ "${SLOTS:-0}" -gt 0 ]; then
    ok "$SLOTS finestre disponibili  ${c_dim}porte $(slot_port 0)…$(slot_port $(( SLOTS - 1 )))${c_off}"
    [ -n "$HOST_NAME" ] || bad "HOST_NAME assente: senza nome mDNS le istanze non sono indirizzabili per porta"
  else
    info "nessuna istanza a finestre (SLOTS=0)"
  fi
  local nr=0; [ -d "$RUNNERS" ] && nr=$(find "$RUNNERS" -maxdepth 1 -name '*.app' | wc -l | tr -d ' ')
  [ "$nr" -gt 0 ] && ok "$nr app con nome e icona propri" || info "nessun lanciatore (winfleet dock <app>)"
  if pgrep -f "WinFleet.app/Contents/MacOS/WinFleet" >/dev/null 2>&1; then
    ok "pannello in barra dei menu"
  else
    info "pannello non aperto (winfleet panel)"
  fi
  if [ -n "$HOST_LAN" ] && [ "$(curl -s --max-time 2 "http://$HOST_LAN:$AGENT_PORT/ping" 2>/dev/null)" = ok ]; then
    ok "agente sull'host: risponde  ${c_dim}(ridimensionamento immediato)${c_off}"
  else
    bad "agente sull'host non risponde: il ridimensionamento restera' indietro"
  fi
  if [ "$CHROME" = native ]; then
    info "barra del titolo di macOS: mostrata (CHROME=native)"
  elif build_chrome && [ -f "$CHROME_LIB" ]; then
    ok "barra del titolo di macOS: tolta  ${c_dim}(resta solo quella dell'app)${c_off}"
  else
    bad "non riesco a compilare wf-chrome.dylib (serve clang): la barra del Mac resta"
  fi
  # Una scheda "Pubblica" sul PC fa cadere il video senza dirlo: lo stream si
  # connette, negozia e decodifica, ma ogni frame arriva incompleto e la finestra
  # resta nera mentre i log dicono che va tutto bene. Windows marca Pubblica ogni
  # rete nuova, quindi ricapita da solo dopo un reinstall o un cambio di scheda.
  # Una sessione bloccata rende nera ogni finestra, e nessun altro controllo se ne
  # accorge: monitor, ritaglio, rete e agente risultano tutti a posto.
  if [ -n "$HOST_SSH" ]; then
    if host_locked; then
      bad "il PC e' sulla schermata di blocco: le finestre resteranno nere"
      info "  sbloccalo una volta e poi:  winfleet unlock  (toglie il blocco automatico)"
    else
      ok "sessione del PC: sbloccata  ${c_dim}(i monitor virtuali disegnano)${c_off}"
    fi
  fi
  if [ -n "$HOST_SSH" ]; then
    local pub
    pub="$(public_nics_on_host)"
    if [ -n "$pub" ]; then
      bad "rete '$pub' sul PC e' marcata Pubblica: lo stream restera' nero"
      info "  sistemala con:  winfleet fixnet"
    else
      ok "reti del PC: private  ${c_dim}(il video passa)${c_off}"
    fi
  fi
  if [ -n "$HOST_TS$HOST_LAN" ]; then
    printf "${c_bold}Percorso${c_off}\n"
    if [ -n "$HOST_LAN" ]; then reachable "$HOST_LAN" "$SUN_PORT" 2 && ok "LAN $HOST_LAN:$SUN_PORT" || info "LAN $HOST_LAN non raggiungibile"; fi
    if [ -n "$HOST_TS" ]; then reachable "$HOST_TS" "$SUN_PORT" 3 && ok "Tailscale $HOST_TS:$SUN_PORT" || info "Tailscale $HOST_TS non raggiungibile"; fi
    read -r addr kind <<<"$(resolve_endpoint)"
    [ -n "$addr" ] && printf "  → userei: ${c_bold}%s${c_off} (%s)\n" "$addr" "$kind" || bad "host irraggiungibile"
  else
    bad "nessun host configurato"
  fi
}

cmd_setup(){
  mkdir -p "$CONFIG_DIR"
  echo "Configurazione WinFleet (host Windows con Sunshine)."
  read -rp "  IP Tailscale del PC (100.x, opzionale): " ts
  read -rp "  IP LAN del PC (192.168.x, opzionale):   " lan
  # Il nome mDNS non e' un dettaglio: Moonlight confronta gli host per indirizzo
  # ignorando la porta, quindi con l'IP nudo tutte le istanze sembrano la stessa.
  read -rp "  Nome mDNS del PC (es. PCdiCasa.local):  " nm
  read -rp "  Quante finestre insieme [2]: " sl; sl="${sl:-2}"
  read -rp "  FPS [60]: " f; f="${f:-60}"
  read -rp "  Bitrate Kbps [auto]: " b; b="${b:-auto}"
  read -rp "  SSH dell'host (utente@indirizzo): " sh
  cat > "$CONFIG" <<CFG
HOST_TS="$ts"
HOST_LAN="$lan"
HOST_NAME="$nm"
HOST_SSH="$sh"
SLOTS="$sl"
SLOT_BASE=48089
FPS=$f
BITRATE=$b
RESOLUTION=auto
SUN_PORT=47990
CFG
  echo "Scritto $CONFIG"
  echo
  echo "Sul PC, una volta sola (PowerShell da amministratore):"
  echo "  .\\setup-vdd.ps1 -Slots $sl"
  echo "  foreach (\$i in 0..$(( sl - 1 ))) { .\\wf-instance.ps1 -Slot \$i }"
  echo
  echo "Poi accoppia ogni finestra dalla GUI di Moonlight, e:  winfleet scan"
}

# ---------------------------------------------------------------------------
case "${1:-}" in
  open)     shift; cmd_open "$@";;
  windows)  cmd_windows;;
  search)   shift; cmd_search "$@";;
  scan)     cmd_scan;;
  push)     cmd_push;;
  fit)      cmd_fit;;
  stop)     shift; cmd_stop "$@";;
  list)     cmd_list;;
  apps)     cmd_apps;;
  dock)     shift; cmd_dock "$@";;
  panel)    cmd_panel;;
  dockpanel|dock-panel) cmd_dockpanel;;
  clean)    cmd_clean;;
  pair)     cmd_pair;;
  endpoint) cmd_endpoint;;
  setup)    cmd_setup;;
  fixnet)   cmd_fixnet;;
  icons)    cmd_icons;;
  unlock)   cmd_unlock;;
  doctor|"") cmd_doctor;;
  -h|--help|help)
    sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//';;
  *) die "Comando sconosciuto: $1  (winfleet --help)";;
esac
