#!/usr/bin/env bash
# WinFleet — finestre di Windows sul Mac, a piena GPU.
#
# Orchestra Sunshine (host, NVENC) + Moonlight (client) per aprire le app o il
# desktop del PC Windows come FINESTRE native macOS, ridimensionabili, fluide,
# riusando la sessione già attiva sul PC (nessun login RDP).
#
#   winfleet open <app>        apre l'app/desktop in una finestra sul Mac
#   winfleet search <testo>    cerca un'app installata sul PC e la apre
#   winfleet windows           stato delle finestre (istanze) e quali sono libere
#   winfleet scan              rilegge l'elenco delle app installate sul PC
#   winfleet fit               riporta la finestra alle proporzioni dello stream
#   winfleet stop              chiude la sessione (graceful)
#   winfleet list              app disponibili sull'host
#   winfleet apps              app configurate localmente (catalogo)
#   winfleet dock [app...]     genera i wrapper .app per il Dock
#   winfleet pair              accoppia Moonlight con l'host (una tantum)
#   winfleet doctor            diagnostica
#   winfleet endpoint          mostra quale indirizzo verrebbe usato (LAN/Tailscale)
set -euo pipefail

# ---------------------------------------------------------------------------
# Config
# ---------------------------------------------------------------------------
CONFIG_DIR="${WINFLEET_CONFIG:-$HOME/.config/winfleet}"
CONFIG="$CONFIG_DIR/config.env"
MOONLIGHT="${MOONLIGHT_BIN:-/Applications/Moonlight.app/Contents/MacOS/Moonlight}"

# Defaults, sovrascrivibili da config.env
HOST_TS=""          # indirizzo Tailscale (sempre raggiungibile)
HOST_LAN=""         # indirizzo LAN (preferito se risponde)
FPS=60
BITRATE=auto        # Kbps, o "auto" = scelto in base alla risoluzione
RESOLUTION=auto     # "auto" = nativa dell'host (nessun riscalo); es. 2560x1440
HOST_RES=""         # risoluzione desktop dell'host, rilevata al primo stream
HOST_NAME=""        # nome mDNS dell'host (es. WindowsAtti.local): indirizza le istanze per porta
SLOTS=0             # quante istanze WinFleet (monitor virtuali) ci sono sull'host
SLOT_BASE=48089     # porta della prima istanza; le successive +100
SUN_PORT=47990
TITLEBAR=28         # altezza barra titolo macOS, esclusa dall'area video

[ -f "$CONFIG" ] && . "$CONFIG"

c_grn=$'\033[32m'; c_red=$'\033[31m'; c_dim=$'\033[2m'; c_bold=$'\033[1m'; c_off=$'\033[0m'
ok(){ printf "  ${c_grn}✓${c_off} %s\n" "$1"; }
bad(){ printf "  ${c_red}✗${c_off} %s\n" "$1"; }
info(){ printf "  ${c_dim}○${c_off} %s\n" "$1"; }
die(){ printf "${c_red}%s${c_off}\n" "$1" >&2; exit 1; }

need_config(){
  [ -n "$HOST_TS$HOST_LAN" ] || die "Nessun host configurato.\nEsegui:  winfleet setup   (o modifica $CONFIG)"
}

# TCP reachability con deadline reale (macOS: connect non rispetta SO_SNDTIMEO)
reachable(){ # host port timeout
  local h="$1" p="$2" t="${3:-2}"
  nc -z -G "$t" "$h" "$p" >/dev/null 2>&1
}

# Sceglie l'endpoint: LAN se risponde sulla porta Sunshine, altrimenti Tailscale.
# La LAN nuda evita l'incapsulamento WireGuard → più banda utile per lo stream.
resolve_endpoint(){
  if [ -n "$HOST_LAN" ] && reachable "$HOST_LAN" "$SUN_PORT" 1; then
    echo "$HOST_LAN lan"
  elif [ -n "$HOST_TS" ] && reachable "$HOST_TS" "$SUN_PORT" 2; then
    echo "$HOST_TS tailscale"
  else
    echo " unreachable"
  fi
}

# ---------------------------------------------------------------------------
# Risoluzione e finestra
# ---------------------------------------------------------------------------
# Moonlight scrive nel suo log la risoluzione del desktop remoto: è il modo
# più diretto di conoscerla, senza chiedere nulla all'host.
detect_host_res(){
  local l; l=$(ls -t /tmp/Moonlight-*.log 2>/dev/null | head -1)
  [ -n "$l" ] || return 1
  grep -oE "desktop resolution: [0-9]+x[0-9]+" "$l" | tail -1 | awk '{print $3}'
}

save_cfg(){ # chiave valore
  local k="$1" v="$2"
  mkdir -p "$CONFIG_DIR"; touch "$CONFIG"
  if grep -q "^$k=" "$CONFIG"; then
    sed -i '' "s|^$k=.*|$k=\"$v\"|" "$CONFIG"
  else
    printf '%s="%s"\n' "$k" "$v" >>"$CONFIG"
  fi
}

# Senza --resolution Moonlight chiede 1280x720 e l'host riscala: immagine molle
# e banda sprecata. Nativa = nessun riscalo.
stream_res(){
  case "$RESOLUTION" in
    auto|"") [ -n "$HOST_RES" ] && echo "$HOST_RES" ;;
    *)       echo "$RESOLUTION" ;;
  esac
}

# Bitrate proporzionato ai pixel: 40 Mbps su un ultrawide è poco, su 720p è spreco.
stream_bitrate(){ # risoluzione
  [ "$BITRATE" = auto ] || { echo "$BITRATE"; return; }
  local res="$1" px
  [ -n "$res" ] || { echo 20000; return; }
  px=$(( ${res%x*} * ${res#*x} ))
  if   [ "$px" -le 1000000 ]; then echo 20000
  elif [ "$px" -le 2100000 ]; then echo 30000
  elif [ "$px" -le 3700000 ]; then echo 50000
  else                             echo 80000
  fi
}

# Moonlight apre due processi (la finestra elenco e quella dello stream) e in
# windowed mode dimensiona la finestra come la risoluzione remota: con un host
# ultrawide finisce fuori dallo schermo del Mac. Questo demone la tiene dentro
# lo schermo e agganciata alle proporzioni dello stream, così si ridimensiona e
# si sposta liberamente ma l'immagine riempie sempre la finestra, senza bande.
stream_pid(){ pgrep -f "Moonlight.*stream" | tail -1; }

win_fix(){ # pid larghezza altezza
  # Il processo va indirizzato con "tell (first process whose unix id is N)":
  # assegnarlo a una variabile e usare "windows of p" fa risolvere il filtro per
  # indice, e con due processi Moonlight si finisce sulla finestra sbagliata.
  osascript >/dev/null 2>&1 <<EOF
set tb to $TITLEBAR
set ar to ($2 / $3)
tell application "Finder" to set sb to bounds of window of desktop
set scrW to item 3 of sb
set scrH to item 4 of sb
try
  tell application "System Events" to tell (first process whose unix id is $1)
    if (count of windows) is 0 then return
    set sz to size of item 1 of windows
    set pos to position of item 1 of windows
    set ww to item 1 of sz
    if ww > (scrW - 40) then set ww to scrW - 40
    set hh to round (ww / ar) rounding as taught in school
    if hh > (scrH - 120) then
      set hh to scrH - 120
      set ww to round (hh * ar) rounding as taught in school
    end if
    if (item 1 of sz) is not ww or (item 2 of sz) is not (hh + tb) then
      set size of item 1 of windows to {ww, hh + tb}
    end if
    set px to item 1 of pos
    set py to item 2 of pos
    if px < 0 then set px to 20
    if py < 30 then set py to 40
    if (px + ww) > scrW then set px to (scrW - ww - 20)
    if (py + hh + tb) > scrH then set py to (scrH - hh - tb - 20)
    if px is not (item 1 of pos) or py is not (item 2 of pos) then
      set position of item 1 of windows to {px, py}
    end if
  end tell
on error
  return
end try
EOF
}

# L'istanza GUI di Moonlight (l'elenco "Computers") resta aperta dietro allo
# stream: nasconderla lascia sullo schermo solo la finestra dell'app.
hide_gui(){ # pid dello stream
  local g
  for g in $(pgrep -x Moonlight 2>/dev/null; pgrep -f "Moonlight$" 2>/dev/null); do
    [ "$g" = "$1" ] && continue
    osascript -e "tell application \"System Events\" to set visible of (first process whose unix id is $g) to false" >/dev/null 2>&1 || true
  done
}

aspect_keeper(){ # pid larghezza altezza
  local pid="$1" rw="$2" rh="$3"
  ( while kill -0 "$pid" 2>/dev/null; do win_fix "$pid" "$rw" "$rh"; sleep 0.5; done ) >/dev/null 2>&1 &
  disown 2>/dev/null || true
}

# Dimensione utile della finestra dello stream, in punti (esclusa la barra titolo).
win_size(){ # pid
  osascript 2>/dev/null <<EOF
try
  tell application "System Events" to tell (first process whose unix id is $1)
    if (count of windows) is 0 then return ""
    set sz to size of item 1 of windows
    return (((item 1 of sz) as integer) as text) & "x" & ((((item 2 of sz) - $TITLEBAR) as integer) as text)
  end tell
on error
  return ""
end try
EOF
}

# macOS non lascia crescere una finestra oltre il bordo dello schermo: se resta dov'e'
# la larghezza viene troncata in silenzio. Quindi prima si sposta, poi si dimensiona.
win_set(){ # pid larghezza altezza
  osascript >/dev/null 2>&1 <<EOF
tell application "Finder" to set sb to bounds of window of desktop
set scrW to item 3 of sb
set scrH to item 4 of sb
try
  tell application "System Events" to tell (first process whose unix id is $1)
    if (count of windows) is 0 then return
    set pos to position of item 1 of windows
    set px to item 1 of pos
    set py to item 2 of pos
    if px < 0 or (px + $2) > scrW then set px to 20
    if py < 30 or (py + $3 + $TITLEBAR) > scrH then set py to 40
    set position of item 1 of windows to {px, py}
    set size of item 1 of windows to {$2, $3 + $TITLEBAR}
    -- Con piu' schermi il rettangolo del desktop e' l'unione, quindi il calcolo
    -- sopra puo' sbagliare e macOS tronca la larghezza: se e' successo, si riprova
    -- dall'angolo.
    set got to size of item 1 of windows
    if (item 1 of got) is not $2 then
      set position of item 1 of windows to {20, 40}
      set size of item 1 of windows to {$2, $3 + $TITLEBAR}
    end if
  end tell
end try
EOF
}

# Quanto puo' essere grande una finestra su questo Mac, in punti. Il rettangolo del
# desktop di Finder e' l'unione di tutti gli schermi e su piu' monitor mente, quindi
# si misura sul serio: si chiede una finestra enorme e si guarda cosa concede macOS.
screen_size(){ # pid di una finestra gia' aperta (opzionale)
  local got=""
  if [ -n "${1:-}" ]; then
    got="$(osascript 2>/dev/null <<EOF
try
  tell application "System Events" to tell (first process whose unix id is $1)
    if (count of windows) is 0 then return ""
    set old to size of item 1 of windows
    set position of item 1 of windows to {0, 0}
    set size of item 1 of windows to {99999, 99999}
    set big to size of item 1 of windows
    set size of item 1 of windows to old
    return (((item 1 of big) as integer) as text) & "x" & (((item 2 of big) as integer) as text)
  end tell
on error
  return ""
end try
EOF
)"
  fi
  if [ -z "$got" ]; then
    got="$(osascript -e 'tell application "Finder" to get bounds of window of desktop' 2>/dev/null |
      awk -F', *' '{printf "%dx%d", $3, $4}')"
  fi
  echo "$got"
}

# Aspetta che il ridimensionamento si fermi e restituisce la modalita' da adottare;
# vuoto se lo stream e' finito. Ridimensionare la finestra sul Mac deve cambiare
# davvero la risoluzione dello schermo su Windows, non scalare l'immagine.
watch_resize(){ # pid slot modalita-corrente
  local pid="$1" slot="$2" mode="$3" cur last="" stable=0 m
  while kill -0 "$pid" 2>/dev/null; do
    cur="$(win_size "$pid")"
    if [ -n "$cur" ] && [ "$cur" != "$mode" ] && [ "$cur" = "$last" ]; then
      stable=$(( stable + 1 ))
      if [ "$stable" -ge 2 ]; then
        m="$(nearest_mode "$slot" "${cur%x*}" "${cur#*x}")"
        if [ -n "$m" ] && [ "$m" != "$mode" ]; then echo "$m"; return 0; fi
        win_set "$pid" "${mode%x*}" "${mode#*x}"   # nessuna modalita' piu' vicina: si torna a filo
        stable=0
      fi
    else
      stable=0
    fi
    last="$cur"
    sleep 0.4
  done
  echo ""
}

# Un ciclo per finestra: apre lo stream, e quando la finestra cambia forma cambia la
# risoluzione del monitor virtuale e riapre. La app resta viva fra un giro e l'altro
# (auto-detach lato host), quindi si ritrova solo ridimensionata.
supervise_window(){ # slot app modalita chiave exe
  local slot="$1" app="$2" mode="$3" key="$4" exe="$5" addr pid br want i
  addr="$(slot_addr "$slot")"
  while true; do
    vdd_set "$slot" "$mode"
    sleep 2
    place_app "$slot" "$exe"
    br="$(stream_bitrate "$mode")"
    "$MOONLIGHT" stream "$addr" Desktop --display-mode windowed --fps "$FPS" --bitrate "$br" \
      --absolute-mouse --no-vsync --quit-after --resolution "$mode" \
      >"$CONFIG_DIR/stream-slot$slot.log" 2>&1 &
    pid=$!
    for i in $(seq 1 60); do sleep 0.5; [ -n "$(win_size "$pid")" ] && break; done
    win_set "$pid" "${mode%x*}" "${mode#*x}"
    hide_gui "$pid"

    want="$(watch_resize "$pid" "$slot" "$mode")"
    kill "$pid" 2>/dev/null
    wait "$pid" 2>/dev/null
    [ -n "$want" ] || break
    mode="$want"
    save_cfg "size_$key" "$mode"
    refresh_vdd
  done
  place_stop "$slot"
}

cmd_fit(){
  local res pid; res="$(stream_res)"; pid="$(stream_pid)"
  [ -n "$res" ] || res="$(detect_host_res)" || die "Risoluzione sconosciuta: avvia uno stream una volta."
  [ -n "$pid" ] || die "Nessuno stream aperto."
  win_fix "$pid" "${res%x*}" "${res#*x}"
  ok "finestra riportata alle proporzioni ${res%x*}:${res#*x}"
}

# ---------------------------------------------------------------------------
# Istanze e monitor virtuali (una finestra per istanza)
# ---------------------------------------------------------------------------
VDD_CACHE="$CONFIG_DIR/vdd.json"

slot_port(){ echo $(( SLOT_BASE + $1 * 100 )); }

# Moonlight cerca prima fra gli host che gia' conosce e li confronta per indirizzo
# ignorando la porta: con "192.168.1.3:48089" finirebbe sull'istanza di sistema.
# Il nome mDNS non collide con nulla, quindi indirizza l'istanza giusta.
slot_addr(){ echo "$HOST_NAME:$(slot_port "$1")"; }

slot_state(){ # slot -> SUNSHINE_SERVER_FREE | ..._BUSY | vuoto
  curl -s --max-time 4 "http://$HOST_NAME:$(slot_port "$1")/serverinfo?uniqueid=winfleet" 2>/dev/null \
    | tr '<' '\n' | awk -F'>' '/^state/{print $2}'
}

pick_slot(){
  local i
  for i in $(seq 0 $(( SLOTS - 1 ))); do
    case "$(slot_state "$i")" in *FREE*) echo "$i"; return 0;; esac
  done
  return 1
}

refresh_vdd(){
  need_ssh
  ssh -o BatchMode=yes -o ConnectTimeout=10 "$HOST_SSH" "type C:\\winfleet\\vdd.json" 2>/dev/null \
    | tr -d '\r' >"$VDD_CACHE.tmp"
  if [ -s "$VDD_CACHE.tmp" ]; then mv "$VDD_CACHE.tmp" "$VDD_CACHE"; else rm -f "$VDD_CACHE.tmp"; fi
}

vdd_field(){ # slot campo
  [ -s "$VDD_CACHE" ] || refresh_vdd
  VDD_CACHE="$VDD_CACHE" WF_SLOT="$1" WF_FIELD="$2" python3 -c '
import json, os, sys
try:
    for m in json.load(open(os.environ["VDD_CACHE"])):
        if m["slot"] == int(os.environ["WF_SLOT"]):
            print(m[os.environ["WF_FIELD"]]); break
except Exception:
    pass
' 2>/dev/null
}

# Il monitor virtuale accetta solo un elenco fisso di modalita': si prende quella
# piu' vicina alla finestra, preferendo una che la contenga.
nearest_mode(){ # slot larghezza altezza
  local modes; modes="$(vdd_field "$1" modes)"
  [ -n "$modes" ] || { echo ""; return; }
  WF_MODES="$modes" WF_W="$2" WF_H="$3" python3 -c '
import os
w, h = int(os.environ["WF_W"]), int(os.environ["WF_H"])
best, score = None, None
for m in os.environ["WF_MODES"].split():
    mw, mh = (int(x) for x in m.split("x"))
    s = (mw - w) ** 2 + (mh - h) ** 2
    if mw < w or mh < h:
        s += 4000000
    if score is None or s < score:
        best, score = m, s
print(best or "")
'
}

# Sunshine non lancia l'app: per aprire una finestra nella sessione interattiva
# duplicherebbe il token della console, privilegio riservato a LocalSystem. La apre
# quindi un task nostro, e Sunshine si limita a trasmettere lo schermo.
place_app(){ # slot percorso-exe
  need_ssh
  ssh -o BatchMode=yes -o ConnectTimeout=10 "$HOST_SSH" \
    "powershell -NoProfile -Command \"schtasks /end /tn winfleet-place$1 | Out-Null; Set-Content 'C:\\winfleet\\app$1.txt' '$2'; Start-Sleep 1; schtasks /run /tn winfleet-place$1 | Out-Null\"" >/dev/null 2>&1
}

place_stop(){ # slot
  [ -n "${HOST_SSH:-}" ] || return 0
  ssh -o BatchMode=yes -o ConnectTimeout=10 "$HOST_SSH" \
    "powershell -NoProfile -Command \"schtasks /end /tn winfleet-place$1 | Out-Null; if (Test-Path 'C:\\winfleet\\pid$1.txt') { Stop-Process -Id ([int](Get-Content 'C:\\winfleet\\pid$1.txt').Trim()) -Force -EA SilentlyContinue }\"" >/dev/null 2>&1
}

app_exe(){ # nome app -> percorso sull'host
  [ -s "$HOST_APPS" ] || return 1
  awk -F'\t' -v n="$1" 'tolower($1)==tolower(n){print $2; exit}' "$HOST_APPS"
}

vdd_set(){ # slot LARGHEZZAxALTEZZA
  need_ssh
  ssh -o BatchMode=yes -o ConnectTimeout=10 "$HOST_SSH" \
    "powershell -NoProfile -Command \"'$1 $2' | Set-Content C:\\winfleet\\vdd-request.txt\"" >/dev/null 2>&1
}

# ---------------------------------------------------------------------------
# Catalogo delle app installate sull'host
# ---------------------------------------------------------------------------
HOST_APPS="$CONFIG_DIR/host-apps.tsv"

need_ssh(){
  [ -n "${HOST_SSH:-}" ] || die "Serve l'accesso SSH all'host per cercare e registrare app.
Aggiungi a $CONFIG:   HOST_SSH=\"utente@indirizzo\""
}

host_ps(){ ssh -o BatchMode=yes -o ConnectTimeout=10 "$HOST_SSH" \
            "powershell -NoProfile -ExecutionPolicy Bypass -File C:\\winfleet\\$1" 2>/dev/null | tr -d '\r'; }

cmd_scan(){
  need_ssh
  info "scansione delle app installate sull'host…"
  host_ps scan-apps.ps1 | grep -v '^$' | sort -f >"$HOST_APPS"
  ok "$(wc -l <"$HOST_APPS" | tr -d ' ') app trovate  ${c_dim}($HOST_APPS)${c_off}"
}

# Registra l'app come "isolata" sull'host, se non lo è già.
ensure_registered(){ # nome percorso
  local name="$1" path="$2"
  if "$MOONLIGHT" list "$(resolve_endpoint | cut -d' ' -f1)" 2>/dev/null | grep -qxF "$name"; then
    return 0
  fi
  info "registro «${name}» sull'host…"
  printf "& 'C:\\\\winfleet\\\\add-isolated-app.ps1' -Name '%s' -Path '%s'\n" \
    "${name//\'/\'\'}" "${path//\'/\'\'}" | base64 | \
    ssh -o BatchMode=yes -o ConnectTimeout=10 "$HOST_SSH" \
      "powershell -NoProfile -Command \"[IO.File]::WriteAllBytes('C:\\winfleet\\_reg.ps1', [Convert]::FromBase64String([Console]::In.ReadToEnd()))\"" || die "Upload fallito."
  host_ps _reg.ps1 >/dev/null || die "Registrazione fallita."
  # Sunshine si riavvia dopo la registrazione: finché non ripubblica l'elenco,
  # Moonlight risponderebbe "Failed to find application".
  local i addr; addr="$(resolve_endpoint | cut -d' ' -f1)"
  for i in $(seq 1 20); do
    "$MOONLIGHT" list "$addr" 2>/dev/null | grep -qxF "$name" && { ok "«${name}» registrata"; return 0; }
    sleep 1
  done
  die "«${name}» registrata ma l'host non la pubblica ancora. Riprova tra qualche secondo." 
}

cmd_search(){
  need_ssh
  [ -s "$HOST_APPS" ] || cmd_scan
  local q="${*:-}"
  local matches; matches=$(grep -i -- "$q" "$HOST_APPS" 2>/dev/null || true)
  [ -n "$matches" ] || die "Nessuna app trovata per «${q}».  Prova:  winfleet scan"

  local n; n=$(printf '%s\n' "$matches" | wc -l | tr -d ' ')
  local pick
  if [ "$n" -eq 1 ]; then
    pick="$matches"
  else
    printf "${c_bold}App che corrispondono a «%s»${c_off}\n" "$q"
    printf '%s\n' "$matches" | nl -w3 -s'. ' | while IFS=$'\t' read -r left _; do printf "  %s\n" "$left"; done
    printf "Quale? [1-%d] " "$n"; read -r sel </dev/tty
    pick=$(printf '%s\n' "$matches" | sed -n "${sel}p")
    [ -n "$pick" ] || die "Selezione non valida."
  fi

  local name path
  name="${pick%%$'\t'*}"; path="${pick#*$'\t'}"
  ensure_registered "$name" "$path"
  cmd_open "$name"
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------
cmd_endpoint(){
  need_config
  read -r addr kind <<<"$(resolve_endpoint)"
  [ -n "$addr" ] || die "Host irraggiungibile (LAN e Tailscale). PC acceso? Sunshine attivo?"
  printf "%s  ${c_dim}(%s)${c_off}\n" "$addr" "$kind"
}

cmd_open(){
  need_config
  local app="${1:-Desktop}"

  # Con le istanze a monitor virtuale ogni app ha il suo schermo: piu' finestre
  # insieme, e ridimensionarle cambia davvero la risoluzione lato Windows.
  if [ "${SLOTS:-0}" -gt 0 ] && [ -n "$HOST_NAME" ] && [ "$app" != "Desktop" ]; then
    local slot key want mode
    slot="$(pick_slot)" || die "Tutte le $SLOTS finestre sono occupate.  winfleet windows"
    refresh_vdd
    key="$(printf '%s' "$app" | tr -cd '[:alnum:]' | tr '[:upper:]' '[:lower:]')"
    want="$(sed -n "s/^size_$key=\"\{0,1\}\([0-9]*x[0-9]*\).*/\1/p" "$CONFIG" 2>/dev/null | tail -1)"
    if [ -z "$want" ]; then
      # Prima apertura: una finestra che sta comoda su questo schermo, non la
      # risoluzione con cui il monitor virtuale si e' acceso.
      local scr; scr="$(screen_size "$(stream_pid)")"
      want="$(( ${scr%x*} * 7 / 10 ))x$(( ${scr#*x} * 7 / 10 ))"
    fi
    mode="$(nearest_mode "$slot" "${want%x*}" "${want#*x}")"
    [ -n "$mode" ] || die "Il monitor virtuale non espone modalita': l'host ha winfleet-vdd attivo?"

    local exe; exe="$(app_exe "$app")" || true
    [ -n "$exe" ] || die "Non so quale eseguibile sia «${app}» sull'host.  winfleet scan"

    printf "${c_bold}%s${c_off} → finestra %d sul Mac  ${c_dim}(%s, %s, %d fps)${c_off}\n" \
      "$app" "$(( slot + 1 ))" "$HOST_NAME" "$mode" "$FPS"
    ( supervise_window "$slot" "$app" "$mode" "$key" "$exe" ) >/dev/null 2>&1 &
    disown 2>/dev/null || true
    return
  fi

  read -r addr kind <<<"$(resolve_endpoint)"
  [ -n "$addr" ] || die "Host irraggiungibile. Controlla:  winfleet doctor"

  # Moonlight risolve il nome dell'app dalla lista che ha in cache: se l'app è
  # stata registrata da poco, senza un refresh risponde "Failed to find application".
  "$MOONLIGHT" list "$addr" >/dev/null 2>&1 || true

  local res br
  res="$(stream_res)"
  br="$(stream_bitrate "$res")"

  local args=( stream "$addr" "$app"
    --display-mode windowed
    --fps "$FPS" --bitrate "$br"
    --absolute-mouse --no-vsync --quit-after )
  [ -n "$res" ] && args+=( --resolution "$res" )

  printf "${c_bold}%s${c_off} → finestra sul Mac  ${c_dim}(%s, %s, %s, %d fps, %s Mbps)${c_off}\n" \
    "$app" "$addr" "$kind" "${res:-nativa}" "$FPS" "$(( br / 1000 ))"
  nohup "$MOONLIGHT" "${args[@]}" >"$CONFIG_DIR/stream-$$.log" 2>&1 &
  local mpid=$!
  disown || true

  # Alla prima connessione impariamo la risoluzione dell'host dal log di
  # Moonlight, così dal secondo stream in poi si va in nativa.
  local i
  for i in $(seq 1 40); do
    sleep 0.5
    [ -n "$res" ] && break
    res="$(detect_host_res || true)"
    [ -n "$res" ] && { save_cfg HOST_RES "$res"; info "risoluzione host rilevata: $res (attiva dal prossimo avvio)"; }
  done

  hide_gui "$mpid"
  [ -n "$res" ] && aspect_keeper "$mpid" "${res%x*}" "${res#*x}"
}

cmd_windows(){
  [ "${SLOTS:-0}" -gt 0 ] || { info "nessuna istanza a finestre configurata (SLOTS=0)"; return; }
  printf "${c_bold}Finestre${c_off}\n"
  local i st
  for i in $(seq 0 $(( SLOTS - 1 ))); do
    st="$(slot_state "$i")"
    case "$st" in
      *FREE*) info "finestra $(( i + 1 ))  libera        ${c_dim}porta $(slot_port "$i")${c_off}";;
      *BUSY*) ok   "finestra $(( i + 1 ))  in uso        $(vdd_field "$i" width)x$(vdd_field "$i" height)";;
      *)      bad  "finestra $(( i + 1 ))  non risponde  ${c_dim}porta $(slot_port "$i")${c_off}";;
    esac
  done
}

cmd_stop(){
  need_config
  read -r addr kind <<<"$(resolve_endpoint)"
  # chiusura graceful della sessione lato host (meglio di uccidere il client:
  # lascia Sunshine libero per la prossima connessione)
  [ -n "$addr" ] && "$MOONLIGHT" quit "$addr" >/dev/null 2>&1 || true
  pkill -f "Moonlight.*stream" 2>/dev/null || true
  echo "Sessione chiusa."
}

cmd_list(){
  need_config
  read -r addr kind <<<"$(resolve_endpoint)"
  [ -n "$addr" ] || die "Host irraggiungibile."
  "$MOONLIGHT" list "$addr" 2>/dev/null | grep -viE "Redirecting" || \
    info "nessuna app (l'host è accoppiato? winfleet pair)"
}

cmd_pair(){
  need_config
  read -r addr kind <<<"$(resolve_endpoint)"
  [ -n "$addr" ] || die "Host irraggiungibile."
  echo "Avvio pairing con $addr…"
  echo "Moonlight mostrerà un PIN: inseriscilo nella web UI di Sunshine"
  echo "  https://$addr:$SUN_PORT   →   PIN"
  "$MOONLIGHT" pair "$addr"
}

cmd_apps(){
  local cat="$CONFIG_DIR/apps.txt"
  [ -f "$cat" ] || { info "nessuna app nel catalogo ($cat)"; return; }
  printf "${c_bold}App configurate${c_off}\n"
  while IFS='|' read -r alias name _; do
    [ -n "$alias" ] && printf "  • %s  ${c_dim}%s${c_off}\n" "$name" "$alias"
  done < "$cat"
}

cmd_dock(){
  local cat="$CONFIG_DIR/apps.txt"
  [ -f "$cat" ] || die "Nessun catalogo app. Aggiungine con:  winfleet add <app> \"<Nome>\""
  local dir="$HOME/Applications/WinFleet"
  mkdir -p "$dir"
  local self; self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"

  local only=("$@")
  while IFS='|' read -r alias name icon; do
    [ -n "$alias" ] || continue
    if [ ${#only[@]} -gt 0 ]; then
      printf '%s\n' "${only[@]}" | grep -qx "$alias" || continue
    fi
    local appdir="$dir/$name.app"
    rm -rf "$appdir"
    mkdir -p "$appdir/Contents/MacOS" "$appdir/Contents/Resources"
    cat > "$appdir/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleName</key><string>$name</string>
  <key>CFBundleIdentifier</key><string>dev.winfleet.$alias</string>
  <key>CFBundleExecutable</key><string>launch</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>1.0</string>
  <key>LSUIElement</key><true/>
</dict></plist>
PLIST
    cat > "$appdir/Contents/MacOS/launch" <<LAUNCH
#!/bin/sh
exec "$self" open "$alias"
LAUNCH
    chmod +x "$appdir/Contents/MacOS/launch"
    [ -n "$icon" ] && [ -f "$CONFIG_DIR/icons/$icon" ] && \
      cp "$CONFIG_DIR/icons/$icon" "$appdir/Contents/Resources/icon.icns" 2>/dev/null || true
    codesign --force -s - "$appdir" >/dev/null 2>&1 || true
    echo "  $appdir"
  done < "$cat"
  echo
  echo "Trascina i .app nel Dock. Click = finestra dell'app sul Mac."
}

cmd_add(){
  local alias="${1:?uso: winfleet add <alias> \"<Nome>\" [icona.icns]}"
  local name="${2:-$alias}"; local icon="${3:-}"
  mkdir -p "$CONFIG_DIR"
  local cat="$CONFIG_DIR/apps.txt"
  touch "$cat"
  grep -v "^$alias|" "$cat" > "$cat.tmp" 2>/dev/null || true; mv "$cat.tmp" "$cat"
  echo "$alias|$name|$icon" >> "$cat"
  echo "Aggiunta: $name ($alias)"
}

cmd_doctor(){
  printf "${c_bold}WinFleet doctor${c_off}\n"
  [ -f "$CONFIG" ] && ok "config: $CONFIG" || bad "config assente: $CONFIG (winfleet setup)"
  [ -x "$MOONLIGHT" ] && ok "Moonlight: $MOONLIGHT" || bad "Moonlight non trovato (brew install --cask moonlight)"
  if [ -n "$HOST_TS$HOST_LAN" ]; then
    printf "${c_bold}Percorso${c_off}\n"
    if [ -n "$HOST_LAN" ]; then reachable "$HOST_LAN" "$SUN_PORT" 2 && ok "LAN $HOST_LAN:$SUN_PORT" || info "LAN $HOST_LAN non raggiungibile"; fi
    if [ -n "$HOST_TS" ]; then reachable "$HOST_TS" "$SUN_PORT" 3 && ok "Tailscale $HOST_TS:$SUN_PORT" || info "Tailscale $HOST_TS non raggiungibile"; fi
    read -r addr kind <<<"$(resolve_endpoint)"
    [ -n "$addr" ] && printf "  → userei: ${c_bold}%s${c_off} (%s)\n" "$addr" "$kind" || bad "host irraggiungibile"
  else
    bad "nessun host configurato"
  fi
}

cmd_setup(){
  mkdir -p "$CONFIG_DIR"
  echo "Configurazione WinFleet (host Windows con Sunshine)."
  read -rp "  IP Tailscale del PC (100.x, opzionale): " ts
  read -rp "  IP LAN del PC (192.168.x, opzionale):   " lan
  read -rp "  FPS [60]: " f; f="${f:-60}"
  read -rp "  Bitrate Kbps [auto]: " b; b="${b:-auto}"
  read -rp "  SSH dell'host (utente@indirizzo, per cercare app): " sh
  cat > "$CONFIG" <<CFG
HOST_TS="$ts"
HOST_LAN="$lan"
HOST_SSH="$sh"
FPS=$f
BITRATE=$b
RESOLUTION=auto
HOST_RES=""
SUN_PORT=47990
CFG
  echo "Scritto $CONFIG"
  echo "Ora accoppia:  winfleet pair"
}

# ---------------------------------------------------------------------------
case "${1:-}" in
  open)     shift; cmd_open "$@";;
  windows)  cmd_windows;;
  search)   shift; cmd_search "$@";;
  scan)     cmd_scan;;
  fit)      cmd_fit;;
  stop)     cmd_stop;;
  list)     cmd_list;;
  apps)     cmd_apps;;
  add)      shift; cmd_add "$@";;
  dock)     shift; cmd_dock "$@";;
  pair)     cmd_pair;;
  endpoint) cmd_endpoint;;
  setup)    cmd_setup;;
  doctor|"") cmd_doctor;;
  -h|--help|help)
    sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//';;
  *) die "Comando sconosciuto: $1  (winfleet --help)";;
esac
